// ======================================================
// CHECK IF ALL ALARMS ARE DONE
// ======================================================

bool allAlarmsCompleted() {

  if (alarms.size() == 0) {
    return false;
  }

  for (int i = 0; i < alarms.size(); i++) {

    if (!alarms[i].done) {
      return false;
    }
  }

  return true;
}

// ======================================================
// MOVE CAROUSEL TO CHAMBER
// ======================================================

bool moveCarouselToChamber(int chamberIndex) {

  if (
    chamberIndex < 0 ||
    chamberIndex >= NUMBER_OF_CHAMBERS
  ) {

    Serial.println(
      "ERROR: Invalid chamber index!"
    );

    return false;
  }

  int targetAngle =
    chamberPositions[chamberIndex];

  Serial.println();
  Serial.println("==============================");

  Serial.print(
    "Moving carousel to Chamber "
  );

  Serial.println(
    chamberIndex + 1
  );

  Serial.print(
    "Target angle: "
  );

  Serial.print(
    targetAngle
  );

  Serial.println(
    " degrees"
  );

  // Move servo
  carouselServo.write(
    targetAngle
  );

  // Give servo time to move
  delay(
    SERVO_SETTLE_TIME
  );

  Serial.print(
    "Chamber "
  );

  Serial.print(
    chamberIndex + 1
  );

  Serial.println(
    " positioned."
  );

  Serial.println(
    "=============================="
  );

  return true;
}

// ======================================================
// RETURN CAROUSEL HOME
// ======================================================

void returnCarouselHome() {

  Serial.println();
  Serial.println("==============================");
  Serial.println(
    "Returning carousel to HOME..."
  );
  Serial.println("==============================");

  carouselServo.write(
    HOME_POSITION
  );

  delay(
    SERVO_SETTLE_TIME
  );

  Serial.println(
    "Carousel at HOME (0 degrees)."
  );

  // Next day starts with Chamber 1
  currentChamberIndex = 0;
}

// ======================================================
// ULTRASONIC DISTANCE
// ======================================================

float getDistanceCM() {

  digitalWrite(
    TRIG_PIN,
    LOW
  );

  delayMicroseconds(2);

  digitalWrite(
    TRIG_PIN,
    HIGH
  );

  delayMicroseconds(10);

  digitalWrite(
    TRIG_PIN,
    LOW
  );

  long duration =
    pulseIn(
      ECHO_PIN,
      HIGH,
      30000
    );

  if (duration == 0) {

    return -1;
  }

  float distance =
    duration * 0.0343 / 2.0;

  return distance;
}

// ======================================================
// HAND DETECTION
// ======================================================

bool detectHand() {

  float distance =
    getDistanceCM();

  if (distance < 0) {

    return false;
  }

  Serial.print(
    "Ultrasonic distance: "
  );

  Serial.print(
    distance
  );

  Serial.println(
    " cm"
  );

  // ----------------------------------------------------
  // HAND IS CLOSE ENOUGH
  // ----------------------------------------------------

  if (
    distance <=
    HAND_DISTANCE_CM
  ) {

    handDetectionCount++;

    Serial.print(
      "Hand detection "
    );

    Serial.print(
      handDetectionCount
    );

    Serial.print(
      "/"
    );

    Serial.println(
      REQUIRED_HAND_DETECTIONS
    );

    // --------------------------------------------------
    // REQUIRED NUMBER OF DETECTIONS REACHED
    // --------------------------------------------------

    if (
      handDetectionCount >=
      REQUIRED_HAND_DETECTIONS
    ) {

      handDetectionCount = 0;

      return true;
    }

  } else {

    // --------------------------------------------------
    // HAND MOVED TOO FAR AWAY
    // --------------------------------------------------

    handDetectionCount = 0;
  }

  return false;
}

// ======================================================
// SELF TEST
// ======================================================

void selfTest() {

  Serial.println(
    "Running self-test..."
  );

  for (
    int i = 0;
    i < 3;
    i++
  ) {

    digitalWrite(
      LED,
      HIGH
    );

    digitalWrite(
      BUZZER,
      HIGH
    );

    delay(150);

    digitalWrite(
      LED,
      LOW
    );

    digitalWrite(
      BUZZER,
      LOW
    );

    delay(150);
  }

  Serial.println(
    "Self-test complete."
  );
}

// ======================================================
// WIFI
// ======================================================

void connectWiFi() {

  Serial.println(
    "Connecting to WiFi..."
  );

  WiFi.begin(
    ssid,
    password
  );

  while (
    WiFi.status() != WL_CONNECTED
  ) {

    Serial.print(
      "."
    );

    delay(300);
  }

  Serial.println(
    "\nConnected!"
  );

  Serial.print(
    "IP: "
  );

  Serial.println(
    WiFi.localIP()
  );
}

// ======================================================
// WIFI RECONNECT
// ======================================================

void ensureWiFi() {

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    Serial.println(
      "Reconnecting WiFi..."
    );

    connectWiFi();
  }
}

// ======================================================
// FORMAT TIME
// ======================================================

String formatTime(
  int hour,
  int minute
) {

  String hh =
    hour < 10
      ? "0" + String(hour)
      : String(hour);

  String mm =
    minute < 10
      ? "0" + String(minute)
      : String(minute);

  return hh + ":" + mm;
}

// ======================================================
// SEND EVENT
// ======================================================

void sendEvent(
  const char* status,
  int hour,
  int minute,
  int snooze,
  int alarmIndex
) {

  ensureWiFi();

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    Serial.println(
      "Cannot send event."
    );

    return;
  }

  DynamicJsonDocument doc(
    512
  );

  doc["device_id"] =
    deviceID;

  doc["status"] =
    status;

  doc["time"] =
    formatTime(
      hour,
      minute
    );

  doc["snooze"] =
    snooze;

  doc["alarmIndex"] =
    alarmIndex;

  String payload;

  serializeJson(
    doc,
    payload
  );

  Serial.println(
    "Sending event:"
  );

  Serial.println(
    payload
  );

  HTTPClient http;

  http.begin(
    eventURL
  );

  http.addHeader(
    "Content-Type",
    "application/json"
  );

  http.addHeader(
    "x-sensor-key",
    sensorApiKey
  );

  int httpCode =
    http.POST(
      payload
    );

  Serial.print(
    "Event POST code: "
  );

  Serial.println(
    httpCode
  );

  if (
    httpCode > 0
  ) {

    String response =
      http.getString();

    Serial.print(
      "Event response: "
    );

    Serial.println(
      response
    );

  } else {

    Serial.print(
      "Event POST failed: "
    );

    Serial.println(
      http.errorToString(
        httpCode
      )
    );
  }

  http.end();
}

// ======================================================
// FETCH SCHEDULE
// ======================================================
//
// IMPORTANT FIX:
//
// Previously:
//
//     alarms.clear();
//
// followed by:
//
//     a.done = false;
//
// This caused already completed alarms to become
// incomplete every 30 seconds.
//
// This version:
//
// 1. Saves the old alarms.
// 2. Downloads the new schedule.
// 3. Matches alarms using hour + minute.
// 4. Preserves the old "done" state.
// 5. New alarms start as done = false.
// 6. Does not refresh while an alarm is active.
//
// ======================================================

void fetchSchedule() {

  // ----------------------------------------------------
  // DO NOT REFRESH WHILE AN ALARM IS ACTIVE
  // ----------------------------------------------------
  //
  // This protects activeAlarmIndex and prevents the
  // alarm list from changing while an alarm is being
  // processed.
  //

  if (
    alarmActive
  ) {

    Serial.println(
      "Schedule refresh skipped - alarm is active."
    );

    return;
  }

  // ----------------------------------------------------
  // CHECK WIFI
  // ----------------------------------------------------

  if (
    WiFi.status() != WL_CONNECTED
  ) {

    return;
  }

  HTTPClient http;

  http.begin(
    scheduleURL
  );

  http.setFollowRedirects(
    HTTPC_STRICT_FOLLOW_REDIRECTS
  );

  Serial.println(
    "\nFetching schedule..."
  );

  int code =
    http.GET();

  Serial.print(
    "HTTP Code: "
  );

  Serial.println(
    code
  );

  // ====================================================
  // SUCCESSFUL RESPONSE
  // ====================================================

  if (
    code == 200
  ) {

    String payload =
      http.getString();

    Serial.println(
      "----- SERVER RESPONSE -----"
    );

    Serial.println(
      payload
    );

    Serial.println(
      "---------------------------"
    );

    // --------------------------------------------------
    // PARSE JSON
    // --------------------------------------------------

    DynamicJsonDocument doc(
      4096
    );

    DeserializationError error =
      deserializeJson(
        doc,
        payload
      );

    if (
      error
    ) {

      Serial.print(
        "JSON Error: "
      );

      Serial.println(
        error.c_str()
      );

      http.end();

      return;
    }

    // ==================================================
    // SAVE OLD ALARMS
    // ==================================================
    //
    // We copy the current alarm list before clearing it.
    //
    // This allows us to preserve "done" states.
    //

    std::vector<Alarm> oldAlarms =
      alarms;

    // ==================================================
    // CLEAR CURRENT ALARM LIST
    // ==================================================

    alarms.clear();

    // ==================================================
    // LOAD NEW ALARMS
    // ==================================================

    for (
      JsonObject obj :
      doc.as<JsonArray>()
    ) {

      Alarm newAlarm;

      newAlarm.hour =
        obj["hour"] | 0;

      newAlarm.minute =
        obj["minute"] | 0;

      // ------------------------------------------------
      // DEFAULT FOR NEW ALARM
      // ------------------------------------------------

      newAlarm.done =
        false;

      // ------------------------------------------------
      // LOOK FOR SAME ALARM IN OLD LIST
      // ------------------------------------------------

      for (
        int j = 0;
        j < oldAlarms.size();
        j++
      ) {

        if (
          oldAlarms[j].hour ==
            newAlarm.hour
          &&
          oldAlarms[j].minute ==
            newAlarm.minute
        ) {

          // --------------------------------------------
          // SAME ALARM FOUND
          //
          // Preserve its previous completion state.
          // --------------------------------------------

          newAlarm.done =
            oldAlarms[j].done;

          Serial.print(
            "Preserved alarm status: "
          );

          Serial.print(
            newAlarm.hour
          );

          Serial.print(
            ":"
          );

          if (
            newAlarm.minute < 10
          ) {

            Serial.print(
              "0"
            );
          }

          Serial.print(
            newAlarm.minute
          );

          Serial.print(
            " | done = "
          );

          Serial.println(
            newAlarm.done
              ? "true"
              : "false"
          );

          break;
        }
      }

      // ------------------------------------------------
      // ADD NEW ALARM
      // ------------------------------------------------

      alarms.push_back(
        newAlarm
      );

      // ------------------------------------------------
      // DISPLAY LOADED ALARM
      // ------------------------------------------------

      Serial.print(
        "Loaded alarm: "
      );

      Serial.print(
        newAlarm.hour
      );

      Serial.print(
        ":"
      );

      if (
        newAlarm.minute < 10
      ) {

        Serial.print(
          "0"
        );
      }

      Serial.print(
        newAlarm.minute
      );

      Serial.print(
        " | done = "
      );

      Serial.println(
        newAlarm.done
          ? "true"
          : "false"
      );
    }

    // ==================================================
    // TOTAL ALARMS
    // ==================================================

    Serial.print(
      "Total alarms: "
    );

    Serial.println(
      alarms.size()
    );

  } else {

    Serial.println(
      "Failed to fetch schedule."
    );
  }

  http.end();
}

// ======================================================
// DISPENSE MEDICINE
// ======================================================

bool dispenseMedicine(
  int alarmIndex
) {

  if (
    alarmIndex < 0
  ) {

    return false;
  }

  // ----------------------------------------------------
  // CAROUSEL LOGIC
  //
  // Alarm 1 → Chamber 1
  // Alarm 2 → Chamber 2
  // Alarm 3 → Chamber 3
  // Alarm 4 → Chamber 4
  //
  // Carousel stays at the current chamber.
  // ----------------------------------------------------

  if (
    currentChamberIndex >=
    NUMBER_OF_CHAMBERS
  ) {

    Serial.println();

    Serial.println(
      "ERROR: All 4 chambers have already been used."
    );

    return false;
  }

  int chamber =
    currentChamberIndex;

  Serial.println();

  Serial.println(
    "=============================="
  );

  Serial.println(
    "DISPENSING MEDICINE"
  );

  Serial.print(
    "Alarm Index: "
  );

  Serial.println(
    alarmIndex
  );

  Serial.print(
    "Chamber: "
  );

  Serial.println(
    chamber + 1
  );

  Serial.print(
    "Servo Angle: "
  );

  Serial.print(
    chamberPositions[chamber]
  );

  Serial.println(
    " degrees"
  );

  Serial.println(
    "=============================="
  );

  // ----------------------------------------------------
  // MOVE TO CHAMBER
  // ----------------------------------------------------

  if (
    !moveCarouselToChamber(
      chamber
    )
  ) {

    return false;
  }

  // ----------------------------------------------------
  // WAIT FOR MEDICINE TO FALL
  // ----------------------------------------------------

  Serial.println(
    "Waiting for medicine to dispense..."
  );

  delay(
    DISPENSE_DELAY
  );

  Serial.println(
    "Medicine should now be dispensed."
  );

  // ----------------------------------------------------
  // MARK AS DISPENSED
  // ----------------------------------------------------

  medicineDispensed =
    true;

  waitingForHand =
    true;

  dispenseTime =
    millis();

  handDetectionCount =
    0;

  // ----------------------------------------------------
  // PREPARE NEXT CHAMBER
  // ----------------------------------------------------

  currentChamberIndex++;

  if (
    currentChamberIndex <
    NUMBER_OF_CHAMBERS
  ) {

    Serial.print(
      "Next alarm will use Chamber "
    );

    Serial.println(
      currentChamberIndex + 1
    );

  } else {

    Serial.println(
      "All 4 chambers have been used."
    );
  }

  // ----------------------------------------------------
  // DO NOT RETURN HOME
  // ----------------------------------------------------

  Serial.println(
    "Carousel will remain at current chamber."
  );

  return true;
}

// ======================================================
// RESET ALARM
// ======================================================

void resetAlarmState() {

  alarmActive =
    false;

  buzzerOn =
    false;

  medicineDispensed =
    false;

  waitingForHand =
    false;

  currentPhase =
    0;

  activeAlarmIndex =
    -1;

  buzzerStart =
    0;

  cycleStart =
    0;

  snoozeWaitStart =
    0;

  handDetectionCount =
    0;

  digitalWrite(
    BUZZER,
    LOW
  );

  digitalWrite(
    LED,
    LOW
  );

  Serial.println(
    "Alarm fully reset."
  );
}

// ======================================================
// START BUZZER
// ======================================================

void startBuzzer() {

  buzzerOn =
    true;

  buzzerStart =
    millis();

  cycleStart =
    millis();

  Serial.println();

  Serial.println(
    "=============================="
  );

  if (
    currentPhase == 0
  ) {

    Serial.println(
      "INITIAL ALARM"
    );

  } else {

    Serial.print(
      "SNOOZE #"
    );

    Serial.println(
      currentPhase
    );
  }

  Serial.println(
    "Buzzer ON for 1 minute."
  );

  Serial.println(
    "=============================="
  );
}

