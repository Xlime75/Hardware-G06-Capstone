// ======================================================
// BUZZER HELPERS
// ======================================================

void buzzerOnSound() {
  if (buzzerOutputActive) {
    return;
  }

  tone(
    BUZZER,
    BUZZER_TONE_HZ
  );

  buzzerOutputActive =
    true;
}

void buzzerOffSound() {
  if (buzzerOutputActive) {
    noTone(
      BUZZER
    );

    buzzerOutputActive =
      false;
  }

  /*
   * Always force the pin LOW as a physical failsafe.
   */
  digitalWrite(
    BUZZER,
    LOW
  );
}

// ======================================================
