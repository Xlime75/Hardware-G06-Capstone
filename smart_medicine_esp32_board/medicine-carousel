// ======================================================
// ULTRASONIC
// ======================================================

const float HAND_DISTANCE_CM = 7.0;

// Number of consecutive detections required
const int REQUIRED_HAND_DETECTIONS = 3;

int handDetectionCount = 0;

// ======================================================
// ALARM TIMING
// ======================================================

// Initial alarm buzzer duration
const unsigned long ALARM_DURATION = 60000;

// Wait 5 minutes before next snooze
const unsigned long SNOOZE_WAIT = 300000;

// Number of snoozes allowed
const int MAX_SNOOZES = 2;

// ======================================================
// ALARM STRUCT
// ======================================================

struct Alarm {
  int hour;
  int minute;
  bool done;
};

std::vector<Alarm> alarms;

// ======================================================
// SYSTEM STATE
// ======================================================

bool alarmActive = false;

bool buzzerOn = false;

bool systemArmed = true;

// Has medicine already been dispensed
// for the current alarm?
bool medicineDispensed = false;

// Is system waiting for user hand?
