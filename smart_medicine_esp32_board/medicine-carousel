// ======================================================
// WIFI
// ======================================================

bool connectWiFi() {
  /*
   * Never block hardware processing while an alarm is active.
   */
  if (alarmActive) {
    return false;
  }

  Serial.println(
    "Connecting to WiFi..."
  );

  WiFi.disconnect(
    true,
    true
  );

  delay(
    200
  );

  WiFi.mode(
    WIFI_STA
  );

  delay(
    100
  );

  WiFi.begin(
    ssid,
    password
  );

  unsigned long start =
    millis();

  while (
    WiFi.status() != WL_CONNECTED
  ) {
    if (alarmActive) {
      Serial.println(
        "WiFi connection stopped because an alarm became active."
      );

      return false;
    }

    if (
      millis() - start >=
      WIFI_CONNECT_TIMEOUT_MS
    ) {
      Serial.println();

      Serial.print(
        "WiFi connection timed out. Status: "
      );

      Serial.println(
        wifiStatusText(
          WiFi.status()
        )
      );

      return false;
    }

    Serial.print(
      "."
    );

    delay(
      300
    );
  }

  Serial.println();
  Serial.println(
    "WiFi connected."
  );

  Serial.print(
    "ESP32 IP: "
  );

  Serial.println(
    WiFi.localIP()
  );

  return true;
}

void ensureWiFi() {
  if (
    alarmActive ||
    WiFi.status() == WL_CONNECTED
  ) {
    return;
  }

  unsigned long now =
    millis();

  if (
    now - lastWiFiAttempt <
    WIFI_RETRY_INTERVAL_MS
  ) {
    return;
  }

  lastWiFiAttempt =
    now;

  connectWiFi();
}

// ======================================================
// TIME FORMAT
// ======================================================

String formatTime(
  int hour,
  int minute
) {
  String hours =
    hour < 10
      ? "0" + String(hour)
      : String(hour);

  String minutes =
    minute < 10
      ? "0" + String(minute)
      : String(minute);

  return (
    hours +
    ":" +
    minutes
  );
}

// ======================================================
// EVENT IDENTIFIER
// ======================================================

String createEventId(
  const String& status,
  const AlarmGroup& group
) {
  return (
    group.groupId +
    "_" +
    status
  );
}

// ======================================================
// SEND EVENT TO BACKEND
// ======================================================

bool sendRxBoxEvent(
  const char* status,
  AlarmGroup& group,
  int snoozeCount
) {
  /*
   * HTTP is prohibited while the hardware alarm is active.
   */
  if (alarmActive) {
    Serial.println(
      "Event send postponed: alarm hardware is active."
    );

    return false;
  }

  ensureWiFi();

  if (
    WiFi.status() != WL_CONNECTED
  ) {
    Serial.println(
      "Cannot send event: no WiFi."
    );

    return false;
  }

  DynamicJsonDocument doc(
    1024
  );

  String statusText =
    String(status);

  String eventId =
    createEventId(
      statusText,
      group
    );

  doc["deviceId"] =
    deviceID;

  doc["eventId"] =
    eventId;

  doc["planId"] =
    currentPlanId;

  doc["groupId"] =
    group.groupId;

  doc["status"] =
    statusText;

  doc["scheduledTime"] =
    group.scheduledTime;

  doc["snoozeCount"] =
    snoozeCount;

  JsonArray chamberArray =
    doc.createNestedArray(
      "chamberIds"
    );

  for (
    int chamberId :
    group.chamberIds
  ) {
    chamberArray.add(
      chamberId
    );
  }

  String payload;

  serializeJson(
    doc,
    payload
  );

  Serial.println();
  Serial.println(
    "Sending Rx Box event:"
  );

  Serial.println(
    payload
  );

  HTTPClient http;

  if (!http.begin(eventURL)) {
    Serial.println(
      "Unable to initialize event HTTP request."
    );

    return false;
  }

  http.setConnectTimeout(
    HTTP_CONNECT_TIMEOUT_MS
  );

  http.setTimeout(
    HTTP_READ_TIMEOUT_MS
  );

  http.setReuse(
    false
  );

  http.addHeader(
    "Content-Type",
    "application/json"
  );

  http.addHeader(
    "x-sensor-key",
    sensorApiKey
  );

  int httpCode =
    http.POST(
      payload
    );

  Serial.print(
    "Event POST code: "
  );

  Serial.println(
    httpCode
  );

  bool successful =
    httpCode >= 200 &&
    httpCode < 300;

  if (httpCode > 0) {
    String response =
      http.getString();

    if (!response.isEmpty()) {
      Serial.print(
        "Event response: "
      );

      Serial.println(
        response
      );
    }
  } else {
    Serial.print(
      "Event POST failed: "
    );

    Serial.println(
      http.errorToString(
        httpCode
      )
    );
  }

  http.end();

  if (successful) {
    Serial.print(
      "Event acknowledged: "
    );

    Serial.println(
      eventId
    );
  } else {
    Serial.println(
      "Backend did not acknowledge the event."
    );
  }

  return successful;
}

// ======================================================
// PENDING EVENT QUEUE
// ======================================================

bool isEventAlreadyQueued(
  const String& eventId
) {
  for (
    const PendingRxBoxEvent& pending :
    pendingEvents
  ) {
    String pendingId =
      createEventId(
        pending.status,
        pending.group
      );

    if (pendingId == eventId) {
      return true;
    }
  }

  return false;
}

void removeQueuedEvent(
  const String& groupId,
  const String& status
) {
  for (
    int index =
      static_cast<int>(
        pendingEvents.size()
      ) - 1;

    index >= 0;

    index--
  ) {
    if (
      pendingEvents[index].group.groupId == groupId &&
      pendingEvents[index].status == status
    ) {
      pendingEvents.erase(
        pendingEvents.begin() +
        index
      );
    }
  }
}

void queueRxBoxEvent(
  const char* status,
  AlarmGroup& group,
  int snoozeCount
) {
  String statusText =
    String(status);

  String eventId =
    createEventId(
      statusText,
      group
    );

  if (
    isEventAlreadyQueued(
      eventId
    )
  ) {
    Serial.print(
      "Event is already queued: "
    );

    Serial.println(
      eventId
    );

    return;
  }

  if (
    pendingEvents.size() >=
    MAX_PENDING_EVENTS
  ) {
    Serial.println(
      "ERROR: Pending backend event queue is full."
    );

    return;
  }

  PendingRxBoxEvent pending;

  pending.status =
    statusText;

  pending.group =
    group;

  pending.snoozeCount =
    snoozeCount;

  pending.lastAttempt =
    millis();

  pendingEvents.push_back(
    pending
  );

  Serial.print(
    "Backend event queued: "
  );

  Serial.println(
    eventId
  );
}

void processPendingRxBoxEvents() {
  if (
    alarmActive ||
    pendingEvents.empty()
  ) {
    return;
  }

  unsigned long now =
    millis();

  for (
    size_t index = 0;
    index < pendingEvents.size();
    index++
  ) {
    if (
      now -
      pendingEvents[index].lastAttempt <
      EVENT_RETRY_INTERVAL_MS
    ) {
      continue;
    }

    pendingEvents[index].lastAttempt =
      now;

    String completedStatus =
      pendingEvents[index].status;

    String completedGroupId =
      pendingEvents[index].group.groupId;

    Serial.print(
      "Sending queued event: "
    );

    Serial.println(
      createEventId(
        pendingEvents[index].status,
        pendingEvents[index].group
      )
    );

    bool sent =
      sendRxBoxEvent(
        pendingEvents[index].status.c_str(),
        pendingEvents[index].group,
        pendingEvents[index].snoozeCount
      );

    if (sent) {
      pendingEvents.erase(
        pendingEvents.begin() +
        index
      );

      Serial.println(
        "Queued event delivered."
      );

      if (
        completedStatus == "taken" ||
        completedStatus == "missed"
      ) {
        removeQueuedEvent(
          completedGroupId,
          "dispensed"
        );
      }
    } else {
      Serial.println(
        "Queued event still failed. It will be retried."
      );
    }

    /*
     * Process only one queued event per loop.
     */
    break;
  }
}

// ======================================================
// FETCH SCHEDULE
// ======================================================

void fetchSchedule() {
  if (alarmActive) {
    Serial.println(
      "Schedule refresh skipped: alarm active."
    );

    return;
  }

  if (
    WiFi.status() != WL_CONNECTED
  ) {
    return;
  }

  HTTPClient http;

  String url =
    String(scheduleURL) +
    "?deviceId=" +
    String(deviceID);

  if (!http.begin(url)) {
    Serial.println(
      "Unable to initialize schedule request."
    );

    return;
  }

  http.setConnectTimeout(
    HTTP_CONNECT_TIMEOUT_MS
  );

  http.setTimeout(
    HTTP_READ_TIMEOUT_MS
  );

  http.setFollowRedirects(
    HTTPC_STRICT_FOLLOW_REDIRECTS
  );

  http.setReuse(
    false
  );

  http.addHeader(
    "x-sensor-key",
    sensorApiKey
  );

  Serial.println();
  Serial.println(
    "Fetching schedule:"
  );

  Serial.println(
    url
  );

  int httpCode =
    http.GET();

  Serial.print(
    "Schedule HTTP code: "
  );

  Serial.println(
    httpCode
  );

  if (
    httpCode == 200 ||
    httpCode == 409
  ) {
    String payload =
      http.getString();

    Serial.println(
      "----- SERVER RESPONSE -----"
    );

    Serial.println(
      payload
    );

    Serial.println(
      "---------------------------"
    );

    DynamicJsonDocument doc(
      6144
    );

    DeserializationError error =
      deserializeJson(
        doc,
        payload
      );

    if (error) {
      Serial.print(
        "Schedule JSON error: "
      );

      Serial.println(
        error.c_str()
      );

      http.end();

      return;
    }

    bool success =
      doc["success"] |
      false;

    if (!success) {
      Serial.print(
        "Server returned success=false: "
      );

      Serial.println(
        doc["error"].as<String>()
      );

      systemArmed =
        false;

      alarms.clear();

      http.end();

      return;
    }

    bool hardwareEnabled =
      doc["hardwareDispensingEnabled"] |
      false;

    currentPlanId =
      doc["planId"].as<String>();

    systemArmed =
      hardwareEnabled;

    if (!hardwareEnabled) {
      Serial.print(
        "Hardware dispensing disabled: "
      );

      Serial.println(
        doc["message"].as<String>()
      );

      alarms.clear();

      http.end();

      return;
    }

    JsonArray groupsArray =
      doc["groups"].as<JsonArray>();

    std::vector<AlarmGroup> oldAlarms =
      alarms;

    alarms.clear();

    for (
      JsonObject object :
      groupsArray
    ) {
      AlarmGroup group;

      group.groupId =
        object["groupId"].as<String>();

      group.hour =
        object["hour"] |
        0;

      group.minute =
        object["minute"] |
        0;

      group.scheduledTime =
        object["scheduledTime"].as<String>();

      group.status =
        object["status"].as<String>();

      group.localDone =
        false;

      JsonArray chamberArray =
        object["chamberIds"].as<JsonArray>();

      for (
        JsonVariant value :
        chamberArray
      ) {
        group.chamberIds.push_back(
          value.as<int>()
        );
      }

      /*
       * Preserve completion state during schedule refresh.
       */
      for (
        size_t oldIndex = 0;
        oldIndex < oldAlarms.size();
        oldIndex++
      ) {
        if (
          !group.groupId.isEmpty() &&
          oldAlarms[oldIndex].groupId ==
            group.groupId
        ) {
          group.localDone =
            oldAlarms[oldIndex].localDone;

          break;
        }
      }

      /*
       * A final backend status is authoritative.
       */
      if (
        group.status == "taken" ||
        group.status == "late" ||
        group.status == "missed"
      ) {
        group.localDone =
          true;
      }

      alarms.push_back(
        group
      );

      Serial.print(
        "Loaded group: "
      );

      Serial.print(
        group.groupId
      );

      Serial.print(
        " at "
      );

      Serial.print(
        formatTime(
          group.hour,
          group.minute
        )
      );

      Serial.print(
        " | Chambers: "
      );

      for (
        int chamberId :
        group.chamberIds
      ) {
        Serial.print(
          chamberId
        );

        Serial.print(
          " "
        );
      }

      Serial.print(
        "| Status: "
      );

      Serial.print(
        group.status
      );

      Serial.print(
        " | Local done: "
      );

      Serial.println(
        group.localDone
          ? "true"
          : "false"
      );
    }

    Serial.print(
      "Total alarm groups: "
    );

    Serial.println(
      alarms.size()
    );

    /*
     * Physical failsafe when every server group is complete.
     */
    if (allAlarmsCompleted()) {
      buzzerOn =
        false;

      buzzerOffSound();

      digitalWrite(
        LED,
        LOW
      );
    }
  } else {
    String response =
      http.getString();

    Serial.println(
      "Failed to fetch schedule."
    );

    if (httpCode < 0) {
      Serial.println(
        http.errorToString(
          httpCode
        )
      );
    }

    if (!response.isEmpty()) {
      Serial.print(
        "Server response: "
      );

      Serial.println(
        response
      );
    }
  }

  http.end();
}

// ======================================================
// DISPENSE MEDICINE
// ======================================================

bool dispenseMedicine(
  AlarmGroup& group
) {
  if (group.chamberIds.empty()) {
    Serial.println(
      "ERROR: No chambers assigned."
    );

    return false;
  }

  Serial.println();
  Serial.println(
    "=============================="
  );

  Serial.println(
    "DISPENSING MEDICINE"
  );

  Serial.print(
    "Group: "
  );

  Serial.println(
    group.groupId
  );

  Serial.print(
    "Scheduled: "
  );

  Serial.println(
    group.scheduledTime
  );

  bool dispensedAny =
    false;

  /*
   * If a group has multiple chambers, for example [2,3],
   * both chambers are moved and dispensed sequentially.
   */
  for (
    int chamberId :
    group.chamberIds
  ) {
    int chamberIndex =
      chamberId - 1;

    if (
      chamberIndex < 0 ||
      chamberIndex >= NUMBER_OF_CHAMBERS
    ) {
      Serial.print(
        "Invalid chamber ID: "
      );

      Serial.println(
        chamberId
      );

      continue;
    }

    Serial.print(
      "Dispensing Chamber "
    );

    Serial.println(
      chamberId
    );

    Serial.print(
      "Servo angle: "
    );

    Serial.println(
      chamberPositions[chamberIndex]
    );

    if (
      !moveCarouselToChamber(
        chamberIndex
      )
    ) {
      continue;
    }

    Serial.println(
      "Waiting for medicine to fall..."
    );

    delay(
      DISPENSE_DELAY_MS
    );

    Serial.println(
      "Medicine dispensed."
    );

    dispensedAny =
      true;

    if (
      chamberId ==
      NUMBER_OF_CHAMBERS
    ) {
      returnCarouselHome();
    } else {
      currentChamberIndex =
        chamberIndex + 1;
    }
  }

  Serial.println(
    "=============================="
  );

  if (!dispensedAny) {
    return false;
  }

  medicineDispensed =
    true;

  waitingForHand =
    true;

  /*
   * Zero forces an immediate sensor reading.
   */
  lastUltrasonicCheck =
    0;

  return true;
}

// ======================================================
// RESET ALARM
// ======================================================

void resetAlarmState() {
  alarmActive =
    false;

  buzzerOn =
    false;

  medicineDispensed =
    false;

  waitingForHand =
    false;

  currentPhase =
    0;

  activeAlarmIndex =
    -1;

  buzzerStart =
    0;

  buzzerCycleStart =
    0;

  snoozeWaitStart =
    0;

  lastUltrasonicCheck =
    0;

  buzzerOffSound();

  digitalWrite(
    LED,
    LOW
  );

  Serial.println(
    "Alarm fully reset."
  );
}

// ======================================================
// START BUZZER
// ======================================================

void startBuzzer() {
  buzzerOn =
    true;

  buzzerStart =
    millis();

  buzzerCycleStart =
    buzzerStart;

  /*
   * Force the first sensor read immediately.
   */
  lastUltrasonicCheck =
    0;

  Serial.println();
  Serial.println(
    "=============================="
  );

  if (currentPhase == 0) {
    Serial.println(
      "INITIAL ALARM"
    );
  } else {
    Serial.print(
      "SNOOZE #"
    );

    Serial.println(
      currentPhase
    );
  }

  Serial.println(
    "Buzzer ON for one minute."
  );

  Serial.print(
    "Ultrasonic armed immediately. Hand range: "
  );

  Serial.print(
    MIN_HAND_DISTANCE_CM,
    2
  );

  Serial.print(
    " to "
  );

  Serial.print(
    MAX_HAND_DISTANCE_CM,
    2
  );

  Serial.println(
    " cm."
  );

  Serial.println(
    "=============================="
  );
}

// ======================================================
// START SNOOZE WAIT
// ======================================================

void startSnoozeWait() {
  buzzerOn =
    false;

  buzzerOffSound();

  digitalWrite(
    LED,
    LOW
  );

  snoozeWaitStart =
    millis();

  Serial.println();
  Serial.println(
    "=============================="
  );

  Serial.println(
    "NO HAND DETECTED"
  );

  Serial.println(
    "Starting five-minute wait..."
  );

  Serial.println(
    "Ultrasonic remains active during the wait."
  );

  Serial.println(
    "=============================="
  );
}

// ======================================================
// COMPLETE TAKEN EVENT
// ======================================================

void completeTakenEvent() {
  /*
   * Stop the physical buzzer before doing anything else.
   */
  buzzerOn =
    false;

  buzzerOffSound();

  digitalWrite(
    LED,
    LOW
  );

  Serial.println();
  Serial.println(
    "=============================="
  );

  Serial.println(
    "HAND DETECTED"
  );

  Serial.println(
    "MEDICINE PICKUP DETECTED"
  );

  Serial.print(
    "Completed during phase: "
  );

  Serial.println(
    currentPhase
  );

  Serial.println(
    "=============================="
  );

  if (
    activeAlarmIndex >= 0 &&
    activeAlarmIndex <
      static_cast<int>(
        alarms.size()
      )
  ) {
    alarms[activeAlarmIndex].localDone =
      true;

    /*
     * Queue the backend event. Do not make an HTTP request
     * until the alarm has been safely reset.
     */
    queueRxBoxEvent(
      "taken",
      alarms[activeAlarmIndex],
      currentPhase
    );
  }

  if (allAlarmsCompleted()) {
    Serial.println(
      "ALL MEDICATIONS COMPLETED"
    );

    returnCarouselHome();
  }

  resetAlarmState();
}

// ======================================================
// COMPLETE MISSED EVENT
// ======================================================

void completeMissedEvent() {
  buzzerOn =
    false;

  buzzerOffSound();

  digitalWrite(
    LED,
    LOW
  );

  Serial.println();
  Serial.println(
    "=============================="
  );

  Serial.println(
    "MEDICATION MISSED"
  );

  Serial.println(
    "=============================="
  );

  if (
    activeAlarmIndex >= 0 &&
    activeAlarmIndex <
      static_cast<int>(
        alarms.size()
      )
  ) {
    alarms[activeAlarmIndex].localDone =
      true;

    queueRxBoxEvent(
      "missed",
      alarms[activeAlarmIndex],
      currentPhase
    );
  }

  if (allAlarmsCompleted()) {
    Serial.println(
      "All alarm groups finished."
    );

    returnCarouselHome();
  }

  resetAlarmState();
}

// ======================================================
// ACTIVE ALARM PROCESSING
// ======================================================

void processActiveAlarm(
  unsigned long now
) {
  if (
    !alarmActive ||
    !medicineDispensed ||
    !waitingForHand
  ) {
    return;
  }

  /*
   * Process the buzzer pattern.
   */
  if (buzzerOn) {
    unsigned long cycle =
      (
        now -
        buzzerCycleStart
      ) %
      1000;

    if (cycle < 300) {
      buzzerOnSound();
    } else {
      buzzerOffSound();
    }

    if (
      now -
      buzzerStart >=
      ALARM_DURATION_MS
    ) {
      Serial.println(
        "One-minute alarm finished."
      );

      startSnoozeWait();
    }
  }

  /*
   * The ultrasonic sensor remains active during:
   * - initial alarm
   * - buzzer-off portion
   * - five-minute snooze wait
   * - repeated snooze alarms
   */
  if (
    now -
    lastUltrasonicCheck >=
    ULTRASONIC_CHECK_INTERVAL_MS
  ) {
    lastUltrasonicCheck =
      now;

    if (detectHand()) {
      completeTakenEvent();

      return;
    }
  }

  /*
   * Handle snooze or missed state after the buzzer has stopped.
   */
  if (
    alarmActive &&
    !buzzerOn &&
    now -
      snoozeWaitStart >=
      SNOOZE_WAIT_MS
  ) {
    currentPhase++;

    if (
      currentPhase <=
      MAX_SNOOZES
    ) {
      Serial.println();
      Serial.println(
        "=============================="
      );

      Serial.print(
        "Starting SNOOZE #"
      );

      Serial.println(
        currentPhase
      );

      Serial.println(
        "=============================="
      );

      startBuzzer();
    } else {
      completeMissedEvent();
    }
  }

  digitalWrite(
    LED,
    buzzerOn
      ? HIGH
      : LOW
  );
}

// ======================================================
// TRIGGER NEXT DUE ALARM
// ======================================================

void triggerDueAlarm(
  int hour,
  int minute
) {
  if (
    alarmActive ||
    !systemArmed
  ) {
    return;
  }

  int currentMinutes =
    hour * 60 +
    minute;

  for (
    size_t index = 0;
    index < alarms.size();
    index++
  ) {
    if (
      alarms[index].localDone
    ) {
      continue;
    }

    int scheduledMinutes =
      alarms[index].hour *
        60 +
      alarms[index].minute;

    int minutesLate =
      currentMinutes -
      scheduledMinutes;

    /*
     * Trigger one minute early through 60 minutes late.
     * This also allows a waiting group to run after a previous
     * close-together medication group finishes.
     */
    bool insideTriggerWindow =
      minutesLate >= -1 &&
      minutesLate <=
        MAX_LATE_TRIGGER_MINUTES;

    if (!insideTriggerWindow) {
      continue;
    }

    Serial.println();
    Serial.println(
      "=============================="
    );

    Serial.println(
      "ALARM TRIGGERED"
    );

    Serial.print(
      "Group: "
    );

    Serial.println(
      alarms[index].groupId
    );

    Serial.print(
      "Scheduled time: "
    );

    Serial.println(
      formatTime(
        alarms[index].hour,
        alarms[index].minute
      )
    );

    Serial.print(
      "Minutes late: "
    );

    Serial.println(
      minutesLate
    );

    Serial.println(
      "=============================="
    );

    alarmActive =
      true;

    activeAlarmIndex =
      static_cast<int>(
        index
      );

    currentPhase =
      0;

    bool dispensed =
      dispenseMedicine(
        alarms[index]
      );

    if (!dispensed) {
      Serial.println(
        "Medicine could not be dispensed."
      );

      resetAlarmState();

      return;
    }

    /*
     * Queue the event instead of sending it now.
     * Network operations are processed after the alarm ends.
     */
    queueRxBoxEvent(
      "dispensed",
      alarms[index],
      0
    );

    /*
     * Start only after every chamber in the same-time group
     * has been positioned and dispensed.
     */
    startBuzzer();

    return;
  }
}

// ======================================================
// SETUP
// ======================================================

void setup() {
  Serial.begin(
    115200
  );

  delay(
    500
  );

  Serial.println();
  Serial.println(
    "=============================="
  );

  Serial.println(
    "BOOTING RX BOX FIRMWARE"
  );

  Serial.println(
    "=============================="
  );

  pinMode(
    LED,
    OUTPUT
  );

  pinMode(
    BUZZER,
    OUTPUT
  );

  pinMode(
    TRIG_PIN,
    OUTPUT
  );

  pinMode(
    ECHO_PIN,
    INPUT
  );

  digitalWrite(
    TRIG_PIN,
    LOW
  );

  digitalWrite(
    BUZZER,
    LOW
  );

  digitalWrite(
    LED,
    LOW
  );

  carouselServo.setPeriodHertz(
    50
  );

  carouselServo.attach(
    CAROUSEL_SERVO,
    500,
    2400
  );

  Serial.println(
    "Moving carousel HOME..."
  );

  carouselServo.write(
    HOME_POSITION
  );

  delay(
    1000
  );

  currentChamberIndex =
    0;

  selfTest();

  int wifiAttempts =
    0;

  while (
    WiFi.status() != WL_CONNECTED &&
    wifiAttempts < 3
  ) {
    wifiAttempts++;

    Serial.print(
      "WiFi attempt "
    );

    Serial.println(
      wifiAttempts
    );

    if (connectWiFi()) {
      break;
    }

    delay(
      1000
    );
  }

  if (
    WiFi.status() == WL_CONNECTED
  ) {
    configTime(
      gmtOffset_sec,
      daylightOffset_sec,
      ntpServer
    );

    Serial.println(
      "Waiting for NTP time..."
    );

    struct tm timeinfo;

    if (
      getLocalTime(
        &timeinfo,
        10000
      )
    ) {
      lastDay =
        timeinfo.tm_mday;

      Serial.print(
        "Time synchronized: "
      );

      Serial.print(
        formatTime(
          timeinfo.tm_hour,
          timeinfo.tm_min
        )
      );

      Serial.println(
        " Asia/Manila"
      );
    } else {
      Serial.println(
        "Initial NTP synchronization timed out."
      );
    }

    fetchSchedule();

    lastFetch =
      millis();
  } else {
    Serial.println(
      "WiFi unavailable. The main loop will retry."
    );
  }

  Serial.println();
  Serial.println(
    "=============================="
  );

  Serial.println(
    "RX BOX READY"
  );

  Serial.println(
    "=============================="
  );
}

// ======================================================
// MAIN LOOP
// ======================================================

void loop() {
  unsigned long now =
    millis();

  /*
   * Highest priority: active alarm and ultrasonic sensor.
   *
   * No WiFi connection, schedule fetch, or HTTP event request
   * is permitted while alarmActive is true.
   */
  if (alarmActive) {
    processActiveAlarm(
      now
    );

    /*
     * If hand detection or missed processing reset the alarm,
     * force the physical outputs off immediately.
     */
    if (!alarmActive) {
      buzzerOffSound();

      digitalWrite(
        LED,
        LOW
      );
    }

    delay(
      20
    );

    return;
  }

  /*
   * Inactive-alarm physical failsafe.
   */
  buzzerOn =
    false;

  buzzerOffSound();

  digitalWrite(
    LED,
    LOW
  );

  /*
   * Network work only happens while no alarm is active.
   */
  ensureWiFi();

  if (
    WiFi.status() == WL_CONNECTED
  ) {
    processPendingRxBoxEvents();

    /*
     * processPendingRxBoxEvents() can block during HTTP.
     * Refresh millis() afterward.
     */
    now =
      millis();

    if (
      now -
      lastFetch >=
      SCHEDULE_FETCH_INTERVAL_MS
    ) {
      fetchSchedule();

      lastFetch =
        millis();
    }
  }

  /*
   * Do not wait several seconds for NTP in the normal loop.
   */
  struct tm timeinfo = {};

  bool timeAvailable =
    getLocalTime(
      &timeinfo,
      20
    );

  if (!timeAvailable) {
    delay(
      100
    );

    return;
  }

  int hour =
    timeinfo.tm_hour;

  int minute =
    timeinfo.tm_min;

  int day =
    timeinfo.tm_mday;

  // ====================================================
  // INITIAL DAY / DAILY RESET
  // ====================================================

  if (lastDay == -1) {
    lastDay =
      day;
  } else if (
    day != lastDay
  ) {
    Serial.println();
    Serial.println(
      "=============================="
    );

    Serial.println(
      "NEW DAY"
    );

    Serial.println(
      "Resetting daily alarm state."
    );

    Serial.println(
      "=============================="
    );

    lastDay =
      day;

    currentChamberIndex =
      0;

    returnCarouselHome();

    for (
      AlarmGroup& alarm :
      alarms
    ) {
      alarm.localDone =
        false;
    }

    /*
     * Load the authoritative schedule and statuses for today.
     */
    fetchSchedule();

    lastFetch =
      millis();
  }

  // ====================================================
  // TRIGGER NEXT DUE GROUP
  // ====================================================

  triggerDueAlarm(
    hour,
    minute
  );

  /*
   * triggerDueAlarm() may have started a new alarm after
   * dispensing, so refresh the timestamp before processing it.
   */
  if (alarmActive) {
    now =
      millis();

    processActiveAlarm(
      now
    );
  }

  /*
   * Final physical failsafe.
   */
  if (
    !alarmActive ||
    !buzzerOn
  ) {
    buzzerOffSound();
  }

  digitalWrite(
    LED,
    alarmActive &&
    buzzerOn
      ? HIGH
      : LOW
  );

  delay(
    20
  );
}
