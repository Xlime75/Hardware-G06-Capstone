// ======================================================
// SETUP
// ======================================================

void setup() {

  Serial.begin(
    115200
  );

  // ====================================================
  // PINS
  // ====================================================

  pinMode(
    LED,
    OUTPUT
  );

  pinMode(
    BUZZER,
    OUTPUT
  );

  pinMode(
    TRIG_PIN,
    OUTPUT
  );

  pinMode(
    ECHO_PIN,
    INPUT
  );

  digitalWrite(
    BUZZER,
    LOW
  );

  digitalWrite(
    LED,
    LOW
  );

  // ====================================================
  // SERVO
  // ====================================================

  carouselServo.setPeriodHertz(
    50
  );

  carouselServo.attach(
    CAROUSEL_SERVO,
    500,
    2400
  );

  // ====================================================
  // START AT HOME
  // ====================================================

  Serial.println(
    "Moving carousel to HOME..."
  );

  carouselServo.write(
    HOME_POSITION
  );

  delay(
    1000
  );

  Serial.println(
    "Carousel HOME = 0 degrees"
  );

  currentChamberIndex =
    0;

  // ====================================================
  // SELF TEST
  // ====================================================

  selfTest();

  // ====================================================
  // WIFI
  // ====================================================

  connectWiFi();

  // ====================================================
  // TIME
  // ====================================================

  configTime(
    gmtOffset_sec,
    daylightOffset_sec,
    ntpServer
  );

  Serial.println(
    "Waiting for time sync..."
  );

  delay(
    2000
  );

  // ====================================================
  // FETCH SCHEDULE
  // ====================================================

  fetchSchedule();

  Serial.println();

  Serial.println(
    "=============================="
  );

  Serial.println(
    "RX BOX READY"
  );

  Serial.println(
    "Carousel HOME = 0 degrees"
  );

  Serial.println(
    "=============================="
  );
}

// ======================================================
// LOOP
// ======================================================

void loop() {

  // ====================================================
  // WIFI
  // ====================================================

  ensureWiFi();

  unsigned long now =
    millis();

  // ====================================================
  // REFRESH SCHEDULE
  // ====================================================
  //
  // Every 30 seconds.
  //
  // fetchSchedule() itself prevents refreshing while
  // an alarm is active.
  //
  // ====================================================

  if (
    now - lastFetch >
    30000
  ) {

    fetchSchedule();

    lastFetch =
      now;
  }

  // ====================================================
  // GET CURRENT TIME
  // ====================================================

  struct tm timeinfo;

  if (
    !getLocalTime(
      &timeinfo
    )
  ) {

    return;
  }

  int h =
    timeinfo.tm_hour;

  int m =
    timeinfo.tm_min;

  int d =
    timeinfo.tm_mday;

  // ====================================================
  // DAILY RESET
  // ====================================================

  if (
    d != lastDay
  ) {

    Serial.println();

    Serial.println(
      "=============================="
    );

    Serial.println(
      "NEW DAY"
    );

    Serial.println(
      "Resetting alarms and carousel."
    );

    Serial.println(
      "=============================="
    );

    lastDay =
      d;

    lastTriggeredMinute =
      -1;

    // --------------------------------------------------
    // START NEW DAY WITH CHAMBER 1
    // --------------------------------------------------

    currentChamberIndex =
      0;

    // --------------------------------------------------
    // RETURN CAROUSEL HOME
    // --------------------------------------------------

    returnCarouselHome();

    // --------------------------------------------------
    // RESET ALL ALARMS FOR NEW DAY
    // --------------------------------------------------

    for (
      auto &a :
      alarms
    ) {

      a.done =
        false;
    }
  }

  // ====================================================
  // TRIGGER ALARM
  // ====================================================

  if (
    !alarmActive &&
    systemArmed
  ) {

    for (
      int i = 0;
      i < alarms.size();
      i++
    ) {

      // ------------------------------------------------
      // CHECK IF THIS ALARM SHOULD TRIGGER
      // ------------------------------------------------

      if (
        !alarms[i].done &&
        h == alarms[i].hour &&
        abs(
          m -
          alarms[i].minute
        ) <= 1 &&
        m != lastTriggeredMinute
      ) {

        Serial.println();

        Serial.println(
          "=============================="
        );

        Serial.println(
          "ALARM TRIGGERED!"
        );

        Serial.print(
          "Alarm #: "
        );

        Serial.println(
          i
        );

        Serial.print(
          "Scheduled Time: "
        );

        Serial.println(
          formatTime(
            alarms[i].hour,
            alarms[i].minute
          )
        );

        Serial.print(
          "Current Chamber: "
        );

        if (
          currentChamberIndex <
          NUMBER_OF_CHAMBERS
        ) {

          Serial.println(
            currentChamberIndex + 1
          );

        } else {

          Serial.println(
            "NONE - ALL CHAMBERS USED"
          );
        }

        Serial.println(
          "=============================="
        );

        // ------------------------------------------------
        // ACTIVATE ALARM
        // ------------------------------------------------

        alarmActive =
          true;

        activeAlarmIndex =
          i;

        currentPhase =
          0;

        lastTriggeredMinute =
          m;

        // ------------------------------------------------
        // DISPENSE MEDICINE
        // ------------------------------------------------

        bool dispensed =
          dispenseMedicine(
            activeAlarmIndex
          );

        // ------------------------------------------------
        // IF DISPENSING FAILED
        // ------------------------------------------------

        if (
          !dispensed
        ) {

          Serial.println(
            "ERROR: Medicine could not be dispensed."
          );

          resetAlarmState();

          break;
        }

        // ------------------------------------------------
        // START INITIAL ALARM
        // ------------------------------------------------

        startBuzzer();

        break;
      }
    }
  }

  // ====================================================
  // BUZZER
  // ====================================================

  if (
    alarmActive &&
    buzzerOn
  ) {

    unsigned long cycle =
      (
        now -
        cycleStart
      ) % 1000;

    // --------------------------------------------------
    // BUZZER PULSE
    //
    // 300ms ON
    // 700ms OFF
    // --------------------------------------------------

    digitalWrite(
      BUZZER,
      (
        cycle < 300
      )
        ? HIGH
        : LOW
    );

    // --------------------------------------------------
    // STOP AFTER 1 MINUTE
    // --------------------------------------------------

    if (
      now -
      buzzerStart >=
      ALARM_DURATION
    ) {

      Serial.println();

      Serial.println(
        "1-minute alarm finished."
      );

      // ------------------------------------------------
      // START 5-MINUTE WAIT
      // ------------------------------------------------

      startSnoozeWait();
    }
  }

  // ====================================================
  // ULTRASONIC HAND DETECTION
  // ====================================================
  //
  // The sensor continues checking while:
  //
  // - Alarm is active
  // - Medicine has been dispensed
  // - System is waiting for hand
  //
  // This means the user can take the medicine:
  //
  // INITIAL ALARM
  // OR
  // SNOOZE #1
  // OR
  // SNOOZE #2
  //
  // ====================================================

  if (
    alarmActive &&
    medicineDispensed &&
    waitingForHand
  ) {

    // --------------------------------------------------
    // WAIT 1.5 SECONDS AFTER DISPENSING
    // --------------------------------------------------
    //
    // Prevents the dispensing process itself from
    // immediately triggering the ultrasonic sensor.
    //

    if (
      now -
      dispenseTime >=
      1500
    ) {

      // ------------------------------------------------
      // CHECK EVERY 100ms
      // ------------------------------------------------

      if (
        now -
        lastUltrasonicCheck >=
        100
      ) {

        lastUltrasonicCheck =
          now;

        // ----------------------------------------------
        // CHECK HAND
        // ----------------------------------------------

        if (
          detectHand()
        ) {

          Serial.println();

          Serial.println(
            "=============================="
          );

          Serial.println(
            "HAND DETECTED!"
          );

          Serial.println(
            "MEDICINE TAKEN"
          );

          Serial.print(
            "Completed during Phase: "
          );

          Serial.println(
            currentPhase
          );

          Serial.println(
            "=============================="
          );

          // --------------------------------------------
          // MARK ALARM AS COMPLETED
          // --------------------------------------------

          if (
            activeAlarmIndex >= 0 &&
            activeAlarmIndex <
              alarms.size()
          ) {

            alarms[
              activeAlarmIndex
            ].done =
              true;

            // ------------------------------------------
            // SEND TAKEN EVENT
            // ------------------------------------------

            sendEvent(
              "taken",
              h,
              m,
              currentPhase,
              activeAlarmIndex
            );
          }

          // --------------------------------------------
          // CHECK IF ALL ALARMS ARE FINISHED
          // --------------------------------------------

          if (
            allAlarmsCompleted()
          ) {

            Serial.println();

            Serial.println(
              "=============================="
            );

            Serial.println(
              "ALL MEDICATIONS COMPLETED!"
            );

            Serial.println(
              "Returning carousel HOME."
            );

            Serial.println(
              "=============================="
            );

            returnCarouselHome();
          }

          // --------------------------------------------
          // RESET CURRENT ALARM
          // --------------------------------------------

          resetAlarmState();
        }
      }
    }
  }

  // ====================================================
  // SNOOZE / MISSED LOGIC
  // ====================================================
  //
  // Phase:
  //
  // 0 = Initial alarm
  // 1 = Snooze #1
  // 2 = Snooze #2
  // 3 = Missed
  //
  // Flow:
  //
  // Initial alarm
  //      ↓
  // 1 minute buzzer
  //      ↓
  // No hand
  //      ↓
  // Wait 5 minutes
  //      ↓
  // Snooze #1
  //      ↓
  // 1 minute buzzer
  //      ↓
  // No hand
  //      ↓
  // Wait 5 minutes
  //      ↓
  // Snooze #2
  //      ↓
  // 1 minute buzzer
  //      ↓
  // No hand
  //      ↓
  // MISSED
  //
  // ====================================================

  if (
    alarmActive &&
    medicineDispensed &&
    waitingForHand &&
    !buzzerOn
  ) {

    // --------------------------------------------------
    // WAIT 5 MINUTES
    // --------------------------------------------------

    if (
      now -
      snoozeWaitStart >=
      SNOOZE_WAIT
    ) {

      // ------------------------------------------------
      // MOVE TO NEXT PHASE
      // ------------------------------------------------

      currentPhase++;

      // ------------------------------------------------
      // SNOOZE #1 OR SNOOZE #2
      // ------------------------------------------------

      if (
        currentPhase <=
        MAX_SNOOZES
      ) {

        Serial.println();

        Serial.println(
          "=============================="
        );

        Serial.print(
          "SNOOZE #"
        );

        Serial.println(
          currentPhase
        );

        Serial.println(
          "No hand detected."
        );

        Serial.println(
          "Buzzer will sound again."
        );

        Serial.println(
          "=============================="
        );

        // ----------------------------------------------
        // START NEXT BUZZER
        // ----------------------------------------------

        startBuzzer();
      }

      // ------------------------------------------------
      // MISSED
      // ------------------------------------------------

      else {

        Serial.println();

        Serial.println(
          "=============================="
        );

        Serial.println(
          "MEDICINE MISSED!"
        );

        Serial.println(
          "No hand detected after all snoozes."
        );

        Serial.println(
          "=============================="
        );

        // ----------------------------------------------
        // MARK ALARM AS MISSED
        // ----------------------------------------------

        if (
          activeAlarmIndex >= 0 &&
          activeAlarmIndex <
            alarms.size()
        ) {

          alarms[
            activeAlarmIndex
          ].done =
            true;

          // --------------------------------------------
          // SEND MISSED EVENT
          // --------------------------------------------

          sendEvent(
            "missed",
            h,
            m,
            currentPhase,
            activeAlarmIndex
          );
        }

        // ----------------------------------------------
        // CHECK IF ALL ALARMS ARE FINISHED
        // ----------------------------------------------

        if (
          allAlarmsCompleted()
        ) {

          Serial.println();

          Serial.println(
            "=============================="
          );

          Serial.println(
            "ALL ALARMS FINISHED."
          );

          Serial.println(
            "Returning carousel HOME."
          );

          Serial.println(
            "=============================="
          );

          returnCarouselHome();
        }

        // ----------------------------------------------
        // RESET CURRENT ALARM
        // ----------------------------------------------

        resetAlarmState();
      }
    }
  }

  // ====================================================
  // LED
  // ====================================================
  //
  // LED follows the buzzer:
  //
  // Buzzer ON  → LED ON
  // Buzzer OFF → LED OFF
  //
  // ====================================================

  digitalWrite(
    LED,
    buzzerOn
      ? HIGH
      : LOW
  );

  // Small loop delay
  delay(50);
}
