#include <Arduino.h>
#include <ESP32Servo.h>

// ======================================================
// RX BOX - HARDWARE TEST PROGRAM
// ======================================================
//
// Tests:
// 1. LED
// 2. Buzzer
// 3. 4-Chamber Carousel
// 4. Ultrasonic Sensor
// 5. Hand Detection
// 6. Automatic Full Hardware Test
//
// No WiFi
// No MongoDB
// No API
// No medication schedule
//
// ======================================================


// ======================================================
// PIN CONFIGURATION
// ======================================================

#define LED 22
#define BUZZER 25

#define CAROUSEL_SERVO 18

#define TRIG_PIN 5
#define ECHO_PIN 19


// ======================================================
// SERVO
// ======================================================

Servo carouselServo;


// ======================================================
// CAROUSEL SETTINGS
// ======================================================

// Home position
const int HOME_POSITION = 0;


// Calibrated chamber positions
//
// Chamber 1 = 65°
// Chamber 2 = 107°
// Chamber 3 = 152°
// Chamber 4 = 180°

const int chamberPositions[] = {
  65,
  107,
  152,
  180
};

const int NUMBER_OF_CHAMBERS = 4;


// ======================================================
// SERVO TIMING
// ======================================================

const int SERVO_SETTLE_TIME = 1000;


// ======================================================
// ULTRASONIC SETTINGS
// ======================================================

// Hand is considered detected at or below this distance
const float HAND_DISTANCE_CM = 7.0;


// Number of consecutive detections required
const int REQUIRED_HAND_DETECTIONS = 3;


// Current detection count
int handDetectionCount = 0;


// ======================================================
// FUNCTION DECLARATIONS
// ======================================================

void printMenu();

void testLED();

void testBuzzer();

void moveCarouselToChamber(int chamberIndex);

void returnCarouselHome();

float getDistanceCM();

void testUltrasonic();

bool detectHand();

void testHandDetection();

void fullHardwareTest();

void stopAll();


// ======================================================
// SETUP
// ======================================================

void setup() {

  // ----------------------------------------------------
  // SERIAL
  // ----------------------------------------------------

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println();
  Serial.println("========================================");
  Serial.println("       RX BOX HARDWARE TEST");
  Serial.println("========================================");
  Serial.println();


  // ----------------------------------------------------
  // PIN MODES
  // ----------------------------------------------------

  pinMode(LED, OUTPUT);

  pinMode(BUZZER, OUTPUT);

  pinMode(TRIG_PIN, OUTPUT);

  pinMode(ECHO_PIN, INPUT);


  // ----------------------------------------------------
  // INITIAL OUTPUT STATE
  // ----------------------------------------------------

  digitalWrite(LED, LOW);

  digitalWrite(BUZZER, LOW);

  digitalWrite(TRIG_PIN, LOW);


  // ----------------------------------------------------
  // SERVO SETUP
  // ----------------------------------------------------

  carouselServo.setPeriodHertz(50);

  carouselServo.attach(
    CAROUSEL_SERVO,
    500,
    2400
  );


  // ----------------------------------------------------
  // MOVE CAROUSEL HOME
  // ----------------------------------------------------

  Serial.println("Initializing carousel...");

  carouselServo.write(HOME_POSITION);

  delay(1500);

  Serial.println("Carousel is at HOME (0 degrees).");


  // ----------------------------------------------------
  // STARTUP TEST
  // ----------------------------------------------------

  Serial.println();
  Serial.println("Running quick startup test...");

  // LED
  digitalWrite(LED, HIGH);
  delay(300);
  digitalWrite(LED, LOW);

  // Buzzer
  digitalWrite(BUZZER, HIGH);
  delay(300);
  digitalWrite(BUZZER, LOW);

  Serial.println("Startup test complete.");

  Serial.println();


  // ----------------------------------------------------
  // PRINT MENU
  // ----------------------------------------------------

  printMenu();
}


// ======================================================
// LOOP
// ======================================================

void loop() {

  // ----------------------------------------------------
  // CHECK SERIAL INPUT
  // ----------------------------------------------------

  if (Serial.available()) {

    char command =
      Serial.read();

    // Convert lowercase to uppercase
    if (
      command >= 'a' &&
      command <= 'z'
    ) {

      command =
        command - 32;
    }


    // ==================================================
    // COMMAND 1 - LED
    // ==================================================

    if (command == '1') {

      testLED();

      printMenu();
    }


    // ==================================================
    // COMMAND 2 - BUZZER
    // ==================================================

    else if (command == '2') {

      testBuzzer();

      printMenu();
    }


    // ==================================================
    // COMMAND 3 - CHAMBER 1
    // ==================================================

    else if (command == '3') {

      moveCarouselToChamber(0);

      printMenu();
    }


    // ==================================================
    // COMMAND 4 - CHAMBER 2
    // ==================================================

    else if (command == '4') {

      moveCarouselToChamber(1);

      printMenu();
    }


    // ==================================================
    // COMMAND 5 - CHAMBER 3
    // ==================================================

    else if (command == '5') {

      moveCarouselToChamber(2);

      printMenu();
    }


    // ==================================================
    // COMMAND 6 - CHAMBER 4
    // ==================================================

    else if (command == '6') {

      moveCarouselToChamber(3);

      printMenu();
    }


    // ==================================================
    // COMMAND 7 - RETURN HOME
    // ==================================================

    else if (command == '7') {

      returnCarouselHome();

      printMenu();
    }


    // ==================================================
    // COMMAND 8 - ULTRASONIC
    // ==================================================

    else if (command == '8') {

      testUltrasonic();

      printMenu();
    }


    // ==================================================
    // COMMAND 9 - HAND DETECTION
    // ==================================================

    else if (command == '9') {

      testHandDetection();

      printMenu();
    }


    // ==================================================
    // COMMAND A - FULL TEST
    // ==================================================

    else if (command == 'A') {

      fullHardwareTest();

      printMenu();
    }


    // ==================================================
    // COMMAND 0 - STOP
    // ==================================================

    else if (command == '0') {

      stopAll();

      printMenu();
    }
  }

  delay(20);
}


// ======================================================
// PRINT MENU
// ======================================================

void printMenu() {

  Serial.println();
  Serial.println("========================================");
  Serial.println("             RX BOX TEST MENU");
  Serial.println("========================================");

  Serial.println("1 - Test LED");
  Serial.println("2 - Test Buzzer");

  Serial.println("3 - Move to Chamber 1");
  Serial.println("4 - Move to Chamber 2");
  Serial.println("5 - Move to Chamber 3");
  Serial.println("6 - Move to Chamber 4");

  Serial.println("7 - Return Carousel HOME");

  Serial.println("8 - Test Ultrasonic Distance");
  Serial.println("9 - Test Hand Detection");

  Serial.println("A - FULL HARDWARE TEST");

  Serial.println("0 - Stop / Reset Outputs");

  Serial.println("========================================");
  Serial.println("Enter command:");
}


// ======================================================
// LED TEST
// ======================================================

void testLED() {

  Serial.println();
  Serial.println("----------------------------------------");
  Serial.println("LED TEST");
  Serial.println("----------------------------------------");

  Serial.println("LED ON");

  digitalWrite(
    LED,
    HIGH
  );

  delay(2000);


  Serial.println("LED OFF");

  digitalWrite(
    LED,
    LOW
  );

  delay(500);

  Serial.println("LED test complete.");
}


// ======================================================
// BUZZER TEST
// ======================================================

void testBuzzer() {

  Serial.println();
  Serial.println("----------------------------------------");
  Serial.println("BUZZER TEST");
  Serial.println("----------------------------------------");

  Serial.println("Buzzer will pulse for 5 seconds.");

  unsigned long startTime =
    millis();


  while (
    millis() -
    startTime <
    5000
  ) {

    // ----------------------------------------------
    // 300ms ON
    // ----------------------------------------------

    digitalWrite(
      BUZZER,
      HIGH
    );

    delay(300);


    // ----------------------------------------------
    // 700ms OFF
    // ----------------------------------------------

    digitalWrite(
      BUZZER,
      LOW
    );

    delay(700);
  }


  digitalWrite(
    BUZZER,
    LOW
  );

  Serial.println("Buzzer test complete.");
}


// ======================================================
// MOVE CAROUSEL TO CHAMBER
// ======================================================

void moveCarouselToChamber(
  int chamberIndex
) {

  // ----------------------------------------------------
  // VALIDATE INDEX
  // ----------------------------------------------------

  if (
    chamberIndex < 0 ||
    chamberIndex >= NUMBER_OF_CHAMBERS
  ) {

    Serial.println(
      "ERROR: Invalid chamber!"
    );

    return;
  }


  // ----------------------------------------------------
  // GET TARGET ANGLE
  // ----------------------------------------------------

  int targetAngle =
    chamberPositions[
      chamberIndex
    ];


  Serial.println();
  Serial.println("----------------------------------------");

  Serial.print(
    "Moving to Chamber "
  );

  Serial.println(
    chamberIndex + 1
  );

  Serial.print(
    "Target angle: "
  );

  Serial.print(
    targetAngle
  );

  Serial.println(
    " degrees"
  );


  // ----------------------------------------------------
  // MOVE SERVO
  // ----------------------------------------------------

  carouselServo.write(
    targetAngle
  );


  // ----------------------------------------------------
  // WAIT FOR SERVO
  // ----------------------------------------------------

  delay(
    SERVO_SETTLE_TIME
  );


  Serial.print(
    "Chamber "
  );

  Serial.print(
    chamberIndex + 1
  );

  Serial.println(
    " positioned."
  );

  Serial.println("----------------------------------------");
}


// ======================================================
// RETURN CAROUSEL HOME
// ======================================================

void returnCarouselHome() {

  Serial.println();
  Serial.println("----------------------------------------");
  Serial.println("RETURNING CAROUSEL HOME");
  Serial.println("----------------------------------------");

  Serial.println(
    "Moving to 0 degrees..."
  );


  carouselServo.write(
    HOME_POSITION
  );


  delay(
    SERVO_SETTLE_TIME
  );


  Serial.println(
    "Carousel is now HOME."
  );

  Serial.println("----------------------------------------");
}


// ======================================================
// GET ULTRASONIC DISTANCE
// ======================================================

float getDistanceCM() {

  // ----------------------------------------------------
  // SEND TRIGGER PULSE
  // ----------------------------------------------------

  digitalWrite(
    TRIG_PIN,
    LOW
  );

  delayMicroseconds(2);


  digitalWrite(
    TRIG_PIN,
    HIGH
  );

  delayMicroseconds(10);


  digitalWrite(
    TRIG_PIN,
    LOW
  );


  // ----------------------------------------------------
  // READ ECHO
  // ----------------------------------------------------

  long duration =
    pulseIn(
      ECHO_PIN,
      HIGH,
      30000
    );


  // ----------------------------------------------------
  // NO RESPONSE
  // ----------------------------------------------------

  if (
    duration == 0
  ) {

    return -1;
  }


  // ----------------------------------------------------
  // CONVERT TO CM
  // ----------------------------------------------------

  float distance =
    duration *
    0.0343 /
    2.0;


  return distance;
}


// ======================================================
// ULTRASONIC TEST
// ======================================================

void testUltrasonic() {

  Serial.println();
  Serial.println("----------------------------------------");
  Serial.println("ULTRASONIC SENSOR TEST");
  Serial.println("----------------------------------------");

  Serial.println(
    "Measuring distance..."
  );

  Serial.println(
    "Move your hand near the sensor."
  );

  Serial.println(
    "Press any key to stop."
  );

  Serial.println();


  while (
    !Serial.available()
  ) {

    float distance =
      getDistanceCM();


    if (
      distance < 0
    ) {

      Serial.println(
        "No echo detected."
      );

    } else {

      Serial.print(
        "Distance: "
      );

      Serial.print(
        distance
      );

      Serial.println(
        " cm"
      );
    }


    delay(500);
  }


  // Clear serial buffer

  while (
    Serial.available()
  ) {

    Serial.read();
  }


  Serial.println();
  Serial.println(
    "Ultrasonic test stopped."
  );
}


// ======================================================
// HAND DETECTION
// ======================================================

bool detectHand() {

  float distance =
    getDistanceCM();


  // ----------------------------------------------------
  // INVALID READING
  // ----------------------------------------------------

  if (
    distance < 0
  ) {

    return false;
  }


  Serial.print(
    "Distance: "
  );

  Serial.print(
    distance
  );

  Serial.println(
    " cm"
  );


  // ----------------------------------------------------
  // HAND CLOSE ENOUGH
  // ----------------------------------------------------

  if (
    distance <=
    HAND_DISTANCE_CM
  ) {

    handDetectionCount++;


    Serial.print(
      "Hand detection: "
    );

    Serial.print(
      handDetectionCount
    );

    Serial.print(
      "/"
    );

    Serial.println(
      REQUIRED_HAND_DETECTIONS
    );


    // --------------------------------------------------
    // REQUIRED DETECTIONS REACHED
    // --------------------------------------------------

    if (
      handDetectionCount >=
      REQUIRED_HAND_DETECTIONS
    ) {

      handDetectionCount = 0;

      return true;
    }

  } else {

    // --------------------------------------------------
    // HAND MOVED AWAY
    // --------------------------------------------------

    handDetectionCount = 0;
  }


  return false;
}


// ======================================================
// HAND DETECTION TEST
// ======================================================

void testHandDetection() {

  Serial.println();
  Serial.println("----------------------------------------");
  Serial.println("HAND DETECTION TEST");
  Serial.println("----------------------------------------");

  Serial.print(
    "Place your hand within "
  );

  Serial.print(
    HAND_DISTANCE_CM
  );

  Serial.println(
    " cm of the sensor."
  );

  Serial.println();

  Serial.println(
    "Press any key to stop."
  );

  Serial.println();


  handDetectionCount = 0;


  while (
    !Serial.available()
  ) {

    if (
      detectHand()
    ) {

      Serial.println();
      Serial.println(
        "***************************************"
      );

      Serial.println(
        "HAND DETECTED!"
      );

      Serial.println(
        "MEDICINE TAKE DETECTION SUCCESSFUL!"
      );

      Serial.println(
        "***************************************"
      );

      Serial.println();

      // Wait for hand to move away
      Serial.println(
        "Move your hand away..."
      );

      delay(1000);

      handDetectionCount = 0;
    }


    delay(300);
  }


  // Clear serial buffer

  while (
    Serial.available()
  ) {

    Serial.read();
  }


  handDetectionCount = 0;


  Serial.println();
  Serial.println(
    "Hand detection test stopped."
  );
}


// ======================================================
// FULL HARDWARE TEST
// ======================================================

