  // ====================================================

  Serial.println();
  Serial.println(
    "[2/7] TESTING BUZZER"
  );

  Serial.println(
    "Buzzer will pulse."
  );


  for (
    int i = 0;
    i < 3;
    i++
  ) {

    digitalWrite(
      BUZZER,
      HIGH
    );

    delay(300);

    digitalWrite(
      BUZZER,
      LOW
    );

    delay(300);
  }


  Serial.println(
    "Buzzer test PASSED."
  );


  // ====================================================
  // TEST 3 - CHAMBER 1
  // ====================================================

  Serial.println();
  Serial.println(
    "[3/7] TESTING CHAMBER 1"
  );

