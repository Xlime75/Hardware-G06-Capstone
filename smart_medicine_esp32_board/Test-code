  // ====================================================
  // TEST 5 - CHAMBER 3
  // ====================================================

  Serial.println();
  Serial.println(
    "[5/7] TESTING CHAMBER 3"
  );

  moveCarouselToChamber(2);

  delay(1000);


  // ====================================================
  // TEST 6 - CHAMBER 4
  // ====================================================

  Serial.println();
  Serial.println(
    "[6/7] TESTING CHAMBER 4"
  );

  moveCarouselToChamber(3);

  delay(1000);


  // ====================================================
  // RETURN HOME
  // ====================================================

  Serial.println();
  Serial.println(
    "[7/7] RETURNING HOME"
  );

  returnCarouselHome();


  // ====================================================
  // ULTRASONIC
  // ====================================================

  Serial.println();
  Serial.println(
    "========================================"
  );

  Serial.println(
    "ULTRASONIC TEST"
  );

  Serial.println(
    "Place your hand near the sensor."
  );

  Serial.println(
