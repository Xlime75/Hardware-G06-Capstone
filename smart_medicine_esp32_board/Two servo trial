// ------------------------------------------------------
// EVENT QUEUE
//
// These functions are called while stateMutex is held.
// ------------------------------------------------------

String createEventId(
  const String& status,
  const AlarmGroup& group
) {
  return group.groupId + "_" + status;
}

bool queueEvent(
  const char* status,
  const AlarmGroup& group,
  int snoozeCount,
  time_t dispensedAt
) {
  const String eventId = createEventId(String(status), group);

  for (const PendingRxBoxEvent& existing : pendingEvents) {
    if (
      createEventId(existing.status, existing.group) == eventId
    ) {
      return true;
    }
  }

  if (pendingEvents.size() >= MAX_PENDING_EVENTS) {
    Serial.println("ERROR: Event queue full.");
    return false;
  }

  PendingRxBoxEvent event;
  event.status = status;
  event.group = group;
  event.planId = currentPlanId;
  event.snoozeCount = snoozeCount;
  event.dispensedAt = dispensedAt;

  pendingEvents.push_back(event);

  Serial.print("Queued event: ");
  Serial.println(eventId);

  return true;
}

bool postEvent(const PendingRxBoxEvent& event) {
  DynamicJsonDocument doc(1536);

  doc["deviceId"] = deviceID;
  doc["eventId"] = createEventId(event.status, event.group);
  doc["planId"] = event.planId;
  doc["groupId"] = event.group.groupId;
  doc["status"] = event.status;
  doc["scheduledTime"] = event.group.scheduledTime;
  doc["snoozeCount"] = event.snoozeCount;

  if (
    event.status == "dispensed" &&
    event.dispensedAt >= MIN_VALID_TIME
  ) {
    doc["dispensedAt"] =
      static_cast<int64_t>(event.dispensedAt);
  }

  JsonArray chambers = doc.createNestedArray("chamberIds");

  for (int chamberId : event.group.chamberIds) {
    chambers.add(chamberId);
  }

  String payload;
  serializeJson(doc, payload);

  HTTPClient http;

  if (!http.begin(eventURL)) {
    return false;
  }

  http.setConnectTimeout(HTTP_CONNECT_TIMEOUT_MS);
  http.setTimeout(HTTP_READ_TIMEOUT_MS);
  http.setReuse(false);

  http.addHeader("Content-Type", "application/json");
  http.addHeader("x-sensor-key", sensorApiKey);

  const int code = http.POST(payload);

  Serial.print("Event HTTP ");
  Serial.print(code);
  Serial.print(" | ");
  Serial.println(createEventId(event.status, event.group));

  bool acknowledged = false;

  if (code >= 200 && code < 300) {
    DynamicJsonDocument response(8192);

    const DeserializationError error =
      deserializeJson(response, http.getString());

    acknowledged =
      !error &&
      response["success"].as<bool>();
  }

  http.end();
  return acknowledged;
}

bool processOneNetworkEvent() {
  PendingRxBoxEvent event;
  bool available = false;

  xSemaphoreTake(stateMutex, portMAX_DELAY);

  // Preserve event order. A final status cannot overtake dispensing.
  if (!pendingEvents.empty()) {
    PendingRxBoxEvent& first = pendingEvents.front();

    const unsigned long now = millis();

    if (
      !first.attempted ||
      now - first.lastAttempt >= EVENT_RETRY_INTERVAL_MS
    ) {
      first.attempted = true;
      first.lastAttempt = now;
      event = first;
      available = true;
    }
  }

  xSemaphoreGive(stateMutex);

  if (!available) {
    return false;
  }

  // No state lock is held during HTTP.
  if (postEvent(event)) {
    const String eventId =
      createEventId(event.status, event.group);

    xSemaphoreTake(stateMutex, portMAX_DELAY);

    for (size_t index = 0; index < pendingEvents.size(); ++index) {
      if (
        createEventId(
          pendingEvents[index].status,
          pendingEvents[index].group
        ) == eventId
      ) {
        pendingEvents.erase(pendingEvents.begin() + index);
        break;
      }
    }

    xSemaphoreGive(stateMutex);
  }

  return true;
}

// ------------------------------------------------------
// SCHEDULE
// ------------------------------------------------------

void fetchSchedule() {
  HTTPClient http;

  const String url =
    String(scheduleURL) + "?deviceId=" + deviceID;

  if (!http.begin(url)) {
    return;
  }

  http.setConnectTimeout(HTTP_CONNECT_TIMEOUT_MS);
  http.setTimeout(HTTP_READ_TIMEOUT_MS);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setReuse(false);
  http.addHeader("x-sensor-key", sensorApiKey);

  const int code = http.GET();

  if (code != 200 && code != 409) {
    Serial.print("Schedule HTTP error: ");
    Serial.println(code);
    http.end();
    return;
  }

  DynamicJsonDocument doc(8192);

  const DeserializationError error =
    deserializeJson(doc, http.getString());

  http.end();

  if (error || !doc["success"].as<bool>()) {
    Serial.println("Schedule response rejected.");
    return;
  }

  const bool enabled =
    doc["hardwareDispensingEnabled"] | false;

  const String planId = doc["planId"].as<String>();
  const String planDate = doc["date"].as<String>();

  if (planId.isEmpty() || planDate.isEmpty()) {
    Serial.println("Schedule has no valid plan identity.");
    return;
  }

  std::vector<AlarmGroup> loaded;

  if (enabled) {
    if (!doc["groups"].is<JsonArray>()) {
      Serial.println("Schedule groups are invalid.");
      return;
    }

    for (JsonObject object : doc["groups"].as<JsonArray>()) {
      AlarmGroup group;

      group.groupId = object["groupId"].as<String>();
      group.hour = object["hour"] | -1;
      group.minute = object["minute"] | -1;
      group.scheduledTime =
        object["scheduledTime"].as<String>();
      group.status = object["status"].as<String>();

      for (
        JsonVariant value :
        object["chamberIds"].as<JsonArray>()
      ) {
        group.chamberIds.push_back(value.as<int>());
      }

      if (!validateGroup(group)) {
        Serial.println("Invalid schedule group rejected.");
        return;
      }

      // A chamber may appear in multiple schedule groups during the day.
      // validateGroup() already rejects duplicate chamber IDs inside one group.

      // A server-recorded dispense must not dispense again after reboot.
      group.started =
        group.status == "dispensed" ||
        group.status == "taken" ||
        group.status == "late" ||
        group.status == "missed";

      group.localDone =
        group.status == "taken" ||
        group.status == "late" ||
        group.status == "missed";

      loaded.push_back(group);
    }
  }

  std::sort(
    loaded.begin(),
    loaded.end(),
    [](const AlarmGroup& left, const AlarmGroup& right) {
      return left.hour * 60 + left.minute <
             right.hour * 60 + right.minute;
    }
  );

  xSemaphoreTake(stateMutex, portMAX_DELAY);

  // A refresh must never replace the active alarm's group.
  if (!alarmActive && !hardwareFault) {
    if (planDate == currentPlanDate) {
      for (AlarmGroup& group : loaded) {
        for (const AlarmGroup& old : alarms) {
          if (old.groupId == group.groupId) {
            group.started = group.started || old.started;
            group.localDone = group.localDone || old.localDone;
            break;
          }
        }
      }
    }

    alarms.swap(loaded);
    currentPlanId = planId;
    currentPlanDate = planDate;
    systemArmed = enabled;

    Serial.print("Schedule loaded | ");
    Serial.print(currentPlanDate);
    Serial.print(" | Groups ");
    Serial.println(alarms.size());
  }

  xSemaphoreGive(stateMutex);
}

// ------------------------------------------------------
// NETWORK TASK
// ------------------------------------------------------

void networkTask(void*) {
  unsigned long lastWiFiAttempt = 0;
  unsigned long lastFetch = 0;
  bool attemptedWiFi = false;
  bool fetched = false;

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);

  while (true) {
    const unsigned long now = millis();

    if (WiFi.status() != WL_CONNECTED) {
      if (
        !attemptedWiFi ||
        now - lastWiFiAttempt >= WIFI_RETRY_INTERVAL_MS
      ) {
        attemptedWiFi = true;
        lastWiFiAttempt = now;

        Serial.println("Starting WiFi connection.");
        WiFi.begin(ssid, password);
      }

      vTaskDelay(pdMS_TO_TICKS(100));
      continue;
    }

    const bool processedEvent = processOneNetworkEvent();

    bool mayFetch = false;

    xSemaphoreTake(stateMutex, portMAX_DELAY);
    mayFetch = !alarmActive;
    xSemaphoreGive(stateMutex);

    if (
      !processedEvent &&
      mayFetch &&
      (!fetched || millis() - lastFetch >= SCHEDULE_FETCH_INTERVAL_MS)
    ) {
      fetched = true;
      lastFetch = millis();
      fetchSchedule();
    }

    vTaskDelay(pdMS_TO_TICKS(50));
  }
}

// ------------------------------------------------------
// ALARM
//
// Called only by the main loop while stateMutex is held.
// ------------------------------------------------------

void resetAlarmState() {
  alarmActive = false;
  buzzerOn = false;
  waitingForHand = false;

  activeAlarmIndex = -1;
  currentPhase = 0;

  buzzerOffSound();
  digitalWrite(LED, LOW);
}

void startBuzzer() {
  buzzerOn = true;
  buzzerStartedAt = millis();

  Serial.print("Alarm phase ");
  Serial.println(currentPhase);
}

void completeAlarm(bool taken) {
  buzzerOn = false;
  buzzerOffSound();
  digitalWrite(LED, LOW);

  if (
    activeAlarmIndex < 0 ||
    activeAlarmIndex >= static_cast<int>(alarms.size())
  ) {
    setHardwareFault("Active group index is invalid.");
    resetAlarmState();
    return;
  }

  AlarmGroup& group = alarms[activeAlarmIndex];

  if (
    !queueEvent(
      taken ? "taken" : "missed",
      group,
      currentPhase,
      0
    )
  ) {
    setHardwareFault("Could not queue final medication event.");
  }

  group.localDone = true;

  // Continuous-rotation carousel has no absolute HOME angle.
  // Keep the last chamber position estimate; startup alignment is manual.

  resetAlarmState();

  if (hardwareFault) {
    digitalWrite(LED, HIGH);
  }
}

void processActiveAlarm() {
  unsigned long now = millis();

  if (buzzerOn) {
    if (now - buzzerStartedAt >= ALARM_DURATION_MS) {
      buzzerOn = false;
      buzzerOffSound();
      snoozeStartedAt = millis();
      Serial.println("Snooze wait started.");
    } else {
      const unsigned long cycle =
        (now - buzzerStartedAt) % 1000;

      if (cycle < 300) {
        buzzerOnSound();
      } else {
        buzzerOffSound();
      }
    }
  }

  now = millis();

  if (
    waitingForHand &&
    now - pickupEnabledAt >= SENSOR_SETTLE_MS &&
    now - lastSensorCheck >= SENSOR_CHECK_INTERVAL_MS
  ) {
    lastSensorCheck = now;

    if (detectHand()) {
      completeAlarm(true);
      return;
    }
  }

  // Refresh after sensor reads and after snoozeStartedAt changes.
  now = millis();

  if (
    !buzzerOn &&
    now - snoozeStartedAt >= SNOOZE_WAIT_MS
  ) {
    ++currentPhase;

    if (currentPhase <= MAX_SNOOZES) {
      startBuzzer();
    } else {
      completeAlarm(false);
      return;
    }
  }

  digitalWrite(LED, buzzerOn ? HIGH : LOW);
}

void triggerDueAlarm(const struct tm& localTime) {
  if (
    alarmActive ||
    !systemArmed ||
    hardwareFault ||
    currentPlanDate != dateKey(localTime)
  ) {
    return;
  }

  const int currentMinutes =
    localTime.tm_hour * 60 + localTime.tm_min;

  for (size_t index = 0; index < alarms.size(); ++index) {
    AlarmGroup& group = alarms[index];

    if (group.started || group.localDone) {
      continue;
    }

    const int scheduledMinutes =
      group.hour * 60 + group.minute;

    const int minutesLate =
      currentMinutes - scheduledMinutes;

    if (
      minutesLate < 0 ||
      minutesLate > MAX_LATE_TRIGGER_MINUTES
    ) {
      continue;
    }

    // Reserve room for dispensing and its eventual final event.
    if (pendingEvents.size() > MAX_PENDING_EVENTS - 2) {
      Serial.println("Dispensing deferred: backend queue is full.");
      return;
    }

    group.started = true;
    alarmActive = true;
    activeAlarmIndex = static_cast<int>(index);
    currentPhase = 0;
    waitingForHand = false;

    Serial.print("DUE GROUP | ");
    Serial.print(group.groupId);
    Serial.print(" | Actual ");
    Serial.print(localTime.tm_hour);
    Serial.print(":");
    Serial.print(localTime.tm_min);
    Serial.print(":");
    Serial.println(localTime.tm_sec);

    time_t dispensedAt = 0;

    if (!dispenseGroup(group, dispensedAt)) {
      // Stop instead of automatically retrying a possibly partial dispense.
      setHardwareFault("Dispensing sequence could not complete.");
      resetAlarmState();
      digitalWrite(LED, HIGH);
      return;
    }

    if (
      !queueEvent(
        "dispensed",
        group,
        0,
        dispensedAt
      )
    ) {
      setHardwareFault("Could not queue dispensing event.");
      resetAlarmState();
      digitalWrite(LED, HIGH);
      return;
    }

    pickupEnabledAt = millis();
    lastSensorCheck = pickupEnabledAt;
    waitingForHand = true;

    startBuzzer();
    return;
  }
}

// ------------------------------------------------------
// SETUP
// ------------------------------------------------------

void setup() {
  Serial.begin(115200);

  pinMode(LED, OUTPUT);
  pinMode(BUZZER, OUTPUT);
  pinMode(PICKUP_SENSOR_PIN, INPUT_PULLUP);

  digitalWrite(LED, LOW);
  digitalWrite(BUZZER, LOW);

  stateMutex = xSemaphoreCreateMutex();

  if (stateMutex == nullptr || !initializeBuzzer()) {
    Serial.println("ERROR: Firmware initialization failed.");

    while (true) {
      digitalWrite(LED, HIGH);
      delay(500);
      digitalWrite(LED, LOW);
      delay(500);
    }
  }

  selfTest();

  carouselServo.setPeriodHertz(50);
  carouselServo.attach(CAROUSEL_SERVO, 500, 2500);

  gateServo.setPeriodHertz(50);
  gateServo.attach(GATE_SERVO, 500, 2500);

  if (!carouselServo.attached() || !gateServo.attached()) {
    setHardwareFault("Servo PWM attachment failed.");
    return;
  }

  // A continuous-rotation servo has no absolute HOME angle.
  // Manually align Chamber 1 with the outlet before powering the box.
  carouselServo.writeMicroseconds(CAROUSEL_STOP_US);
  currentCarouselChamber = 1;
  if (!closeGate()) {
    setHardwareFault("Initial gate-close command failed.");
    return;
  }
  Serial.println("STARTUP POSITION ASSUMPTION: Chamber 1 is aligned with outlet.");

  // NTP can synchronize when the network task connects.
  configTime(
    GMT_OFFSET_SECONDS,
    DAYLIGHT_OFFSET_SECONDS,
    ntpServer
  );

  const BaseType_t created = xTaskCreate(
    networkTask,
    "rxNetwork",
    12288,
    nullptr,
    1,
    &networkTaskHandle
  );

  if (created != pdPASS) {
    setHardwareFault("Network task could not start.");
    return;
  }

  Serial.println("RX BOX READY");
  Serial.println("Carousel: 3 towers, timed continuous rotation.");
  Serial.println("Gate: 180-degree servo; pickup: digital IR sensor.");
  Serial.println("Initial alarm = phase 0; first snooze = phase 1.");
}

// ------------------------------------------------------
// HARDWARE LOOP
// ------------------------------------------------------

void loop() {
  xSemaphoreTake(stateMutex, portMAX_DELAY);

  if (hardwareFault) {
    buzzerOffSound();
    digitalWrite(LED, HIGH);

    xSemaphoreGive(stateMutex);
    delay(20);
    return;
  }

  if (alarmActive) {
    processActiveAlarm();
  } else {
    buzzerOffSound();
    digitalWrite(LED, LOW);

    struct tm localTime = {};

    if (readClock(localTime)) {
      triggerDueAlarm(localTime);
    }
  }

  xSemaphoreGive(stateMutex);

  delay(10);
}
