// ------------------------------------------------------
// CLOCK
// ------------------------------------------------------

bool readClock(struct tm& localTime) {
  const time_t now = time(nullptr);

  if (now < MIN_VALID_TIME) {
    return false;
  }

  return localtime_r(&now, &localTime) != nullptr;
}

String dateKey(const struct tm& localTime) {
  char buffer[11];

  strftime(
    buffer,
    sizeof(buffer),
    "%Y-%m-%d",
    &localTime
  );

  return String(buffer);
}

