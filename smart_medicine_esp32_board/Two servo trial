// ======================================================
// CLOCK
// ======================================================

bool readClock(struct tm& localTime) {
  const time_t now = time(nullptr);

  if (now < MIN_VALID_TIME) {
    return false;
  }

  return localtime_r(&now, &localTime) != nullptr;
}

String dateKey(const struct tm& localTime) {
  char buffer[11];

  strftime(
    buffer,
    sizeof(buffer),
    "%Y-%m-%d",
    &localTime
  );

  return String(buffer);
}

// ======================================================
// MOTOR CONTROL
// ======================================================

void setHardwareFault(const char* message) {
  // Issue stop and close commands when possible.
  if (carouselServo.attached()) {
    carouselServo.writeMicroseconds(CAROUSEL_STOP_US);
  }

  if (gateServo.attached()) {
    gateServo.write(GATE_CLOSED_ANGLE);
  }

  carouselStopped = true;
  gateClosed = false;

  hardwareFault = true;
  systemArmed = false;

  buzzerOffSound();
  digitalWrite(LED, HIGH);

  Serial.print("HARDWARE FAULT: ");
  Serial.println(message);
}

bool stopCarousel() {
  if (!carouselServo.attached()) {
    return false;
  }

  carouselServo.writeMicroseconds(CAROUSEL_STOP_US);
  delay(CAROUSEL_SETTLE_TIME_MS);

  carouselStopped = true;
  return true;
}

bool rotateCarouselSteps(int direction, int steps) {
  if (
    !carouselServo.attached() ||
    !gateClosed ||
    steps < 0 ||
    steps > 2
  ) {
    return false;
  }

  if (steps == 0) {
    return stopCarousel();
  }

  const int pulse =
    direction > 0 ? CAROUSEL_CW_US : CAROUSEL_CCW_US;

  const unsigned long timePerStep =
    direction > 0
      ? CAROUSEL_CW_90_MS
      : CAROUSEL_CCW_90_MS;

  const unsigned long rotationTime =
    timePerStep * static_cast<unsigned long>(steps);

  Serial.print("CAROUSEL ROTATE | Direction: ");
  Serial.print(direction > 0 ? "CW" : "CCW");
  Serial.print(" | 90-degree steps: ");
  Serial.print(steps);
  Serial.print(" | Duration ms: ");
  Serial.println(rotationTime);

  carouselStopped = false;

  carouselServo.writeMicroseconds(pulse);
  delay(rotationTime);

  return stopCarousel();
}

bool moveCarouselToChamber(int chamberId) {
  if (
    chamberId < 1 ||
    chamberId > NUMBER_OF_CHAMBERS ||
    !carouselServo.attached()
  ) {
    return false;
  }

  buzzerOffSound();

  const int targetIndex = chamberId - 1;
  const int currentIndex = currentCarouselChamber - 1;

  const int clockwiseSteps =
    (
      targetIndex -
      currentIndex +
      NUMBER_OF_CHAMBERS
    ) % NUMBER_OF_CHAMBERS;

  const int counterClockwiseSteps =
    (
      currentIndex -
      targetIndex +
      NUMBER_OF_CHAMBERS
    ) % NUMBER_OF_CHAMBERS;

  // Use the shorter route. A 180-degree tie uses CW.
  if (clockwiseSteps <= counterClockwiseSteps) {
    if (!rotateCarouselSteps(1, clockwiseSteps)) {
      return false;
    }
  } else {
    if (!rotateCarouselSteps(-1, counterClockwiseSteps)) {
      return false;
    }
  }

  currentCarouselChamber = chamberId;

  Serial.print("CAROUSEL POSITION ESTIMATE: Chamber ");
  Serial.println(currentCarouselChamber);

  return true;
}

bool openGate() {
  if (
    !gateServo.attached() ||
    !carouselStopped ||
    hardwareFault
  ) {
    return false;
  }

  gateClosed = false;

  gateServo.write(GATE_OPEN_ANGLE);
  delay(GATE_SETTLE_TIME_MS);

  return true;
}

bool closeGate() {
  if (!gateServo.attached()) {
    return false;
  }

  gateClosed = false;

  gateServo.write(GATE_CLOSED_ANGLE);
  delay(GATE_SETTLE_TIME_MS);

  gateClosed = true;
  return true;
}

bool validateGroup(const AlarmGroup& group) {
  if (
    group.groupId.isEmpty() ||
    group.scheduledTime.isEmpty() ||
    group.hour < 0 ||
    group.hour > 23 ||
    group.minute < 0 ||
    group.minute > 59 ||
    group.chamberIds.empty() ||
    group.chamberIds.size() > NUMBER_OF_CHAMBERS
  ) {
    return false;
  }

  bool used[NUMBER_OF_CHAMBERS] = {};

  for (int chamberId : group.chamberIds) {
    if (
      chamberId < 1 ||
      chamberId > NUMBER_OF_CHAMBERS ||
      used[chamberId - 1]
    ) {
      return false;
    }

    used[chamberId - 1] = true;
  }

  return true;
}

bool dispenseGroup(
  const AlarmGroup& group,
  time_t& dispensedAt
) {
  dispensedAt = 0;

  if (
    !validateGroup(group) ||
    !carouselServo.attached() ||
    !gateServo.attached()
  ) {
    return false;
  }

  // Close and allow the gate to settle before moving.
  if (!closeGate()) {
    return false;
  }

  // Use the API's assigned chamber IDs directly.
  // Scheduled time controls WHEN, not WHICH chamber.
  for (int chamberId : group.chamberIds) {
    if (!moveCarouselToChamber(chamberId)) {
      return false;
    }

    Serial.print("DISPENSING | Chamber ");
    Serial.println(chamberId);

    // moveCarouselToChamber has already issued STOP
    // and completed its settling delay.
    if (!openGate()) {
      return false;
    }

    delay(DISPENSE_DELAY_MS);

    // Finish closing before another chamber can move.
    if (!closeGate()) {
      return false;
    }
  }

  // Do not send a positional HOME angle to a
  // continuous-rotation servo.
  dispensedAt = time(nullptr);

  Serial.println(
    "Dispensing sequence completed; gate closed."
  );

  return true;
}

// ======================================================
// PICKUP SENSOR
// Same ultrasonic detection as the working reference.
// ======================================================

float getDistanceCM() {
  // A stuck-high echo is an invalid measurement.
  if (digitalRead(ECHO_PIN) == HIGH) {
    return -1.0;
  }

  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  const unsigned long duration = pulseIn(
    ECHO_PIN,
    HIGH,
    SENSOR_ECHO_TIMEOUT_US
  );

  if (duration == 0) {
    return -1.0;
  }

  return duration * 0.0343f / 2.0f;
}

bool detectHand() {
  const float distance = getDistanceCM();

  // One valid reading for every chamber and alarm phase.
  if (
    distance >= MIN_HAND_DISTANCE_CM &&
    distance <= MAX_HAND_DISTANCE_CM
  ) {
    Serial.print("PICKUP | Distance ");
    Serial.print(distance, 2);
    Serial.println(" cm");

    return true;
  }

  return false;
}

// ======================================================
// EVENT QUEUE
// Queue modifications require stateMutex.
// ======================================================

String createEventId(
  const String& status,
  const AlarmGroup& group
) {
  return group.groupId + "_" + status;
}

bool queueEvent(
  const char* status,
  const AlarmGroup& group,
  int snoozeCount,
  time_t dispensedAt
) {
  const String eventId =
    createEventId(String(status), group);

  for (const PendingRxBoxEvent& existing : pendingEvents) {
    if (
      createEventId(existing.status, existing.group) ==
      eventId
    ) {
      return true;
    }
  }

  if (pendingEvents.size() >= MAX_PENDING_EVENTS) {
    Serial.println("ERROR: Event queue full.");
    return false;
  }

  PendingRxBoxEvent event;

  event.status = status;
  event.group = group;
  event.planId = currentPlanId;
  event.snoozeCount = snoozeCount;
  event.dispensedAt = dispensedAt;

  pendingEvents.push_back(event);

  Serial.print("Queued event: ");
  Serial.println(eventId);

  return true;
}

bool postEvent(const PendingRxBoxEvent& event) {
  DynamicJsonDocument doc(1536);

  doc["deviceId"] = deviceID;
  doc["eventId"] = createEventId(event.status, event.group);
  doc["planId"] = event.planId;
  doc["groupId"] = event.group.groupId;
  doc["status"] = event.status;
  doc["scheduledTime"] = event.group.scheduledTime;
  doc["snoozeCount"] = event.snoozeCount;

  if (
    event.status == "dispensed" &&
    event.dispensedAt >= MIN_VALID_TIME
  ) {
    doc["dispensedAt"] =
      static_cast<int64_t>(event.dispensedAt);
  }

  JsonArray chambers = doc.createNestedArray("chamberIds");

  for (int chamberId : event.group.chamberIds) {
    chambers.add(chamberId);
  }

  String payload;
  serializeJson(doc, payload);

  HTTPClient http;

  if (!http.begin(eventURL)) {
    return false;
  }

  http.setConnectTimeout(HTTP_CONNECT_TIMEOUT_MS);
  http.setTimeout(HTTP_READ_TIMEOUT_MS);
  http.setReuse(false);

  http.addHeader("Content-Type", "application/json");
  http.addHeader("x-sensor-key", sensorApiKey);

  const int code = http.POST(payload);

  Serial.print("Event HTTP ");
  Serial.print(code);
  Serial.print(" | ");
  Serial.println(createEventId(event.status, event.group));

  bool acknowledged = false;

  if (code >= 200 && code < 300) {
    DynamicJsonDocument response(8192);

    const DeserializationError error =
      deserializeJson(response, http.getString());

    acknowledged =
      !error &&
      response["success"].as<bool>();
  }

  http.end();
  return acknowledged;
}

bool processOneNetworkEvent() {
  PendingRxBoxEvent event;
  bool available = false;

  xSemaphoreTake(stateMutex, portMAX_DELAY);

  // Preserve ordering: final status cannot overtake
  // its preceding dispensing event.
  if (!pendingEvents.empty()) {
    PendingRxBoxEvent& first = pendingEvents.front();

    const unsigned long now = millis();

    if (
      !first.attempted ||
      now - first.lastAttempt >= EVENT_RETRY_INTERVAL_MS
    ) {
      first.attempted = true;
      first.lastAttempt = now;

      event = first;
      available = true;
    }
  }

  xSemaphoreGive(stateMutex);

  if (!available) {
    return false;
  }

  // HTTP runs without the hardware state lock.
  // Sensor checks and alarms can continue.
  if (postEvent(event)) {
    const String eventId =
      createEventId(event.status, event.group);

    xSemaphoreTake(stateMutex, portMAX_DELAY);

    for (size_t index = 0; index < pendingEvents.size(); ++index) {
      if (
        createEventId(
          pendingEvents[index].status,
          pendingEvents[index].group
        ) == eventId
      ) {
        pendingEvents.erase(pendingEvents.begin() + index);
        break;
      }
    }

    xSemaphoreGive(stateMutex);
  }

  return true;
}

// ======================================================
// SCHEDULE
// ======================================================

void fetchSchedule() {
  HTTPClient http;

  const String url =
    String(scheduleURL) + "?deviceId=" + deviceID;

  if (!http.begin(url)) {
    return;
  }

  http.setConnectTimeout(HTTP_CONNECT_TIMEOUT_MS);
  http.setTimeout(HTTP_READ_TIMEOUT_MS);
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setReuse(false);

  http.addHeader("x-sensor-key", sensorApiKey);

  const int code = http.GET();

  if (code != 200 && code != 409) {
    Serial.print("Schedule HTTP error: ");
    Serial.println(code);

    http.end();
    return;
  }

  DynamicJsonDocument doc(8192);

  const DeserializationError error =
    deserializeJson(doc, http.getString());

  http.end();

  if (error || !doc["success"].as<bool>()) {
    Serial.println("Schedule response rejected.");
    return;
  }

  const bool enabled =
    doc["hardwareDispensingEnabled"] | false;

  const String planId = doc["planId"].as<String>();
  const String planDate = doc["date"].as<String>();

  if (planId.isEmpty() || planDate.isEmpty()) {
    Serial.println("Schedule has no valid plan identity.");
    return;
  }

  std::vector<AlarmGroup> loaded;

  if (enabled) {
    if (!doc["groups"].is<JsonArray>()) {
      Serial.println("Schedule groups are invalid.");
      return;
    }

    bool assigned[NUMBER_OF_CHAMBERS] = {};

    for (JsonObject object : doc["groups"].as<JsonArray>()) {
      AlarmGroup group;

      group.groupId = object["groupId"].as<String>();
      group.hour = object["hour"] | -1;
      group.minute = object["minute"] | -1;
      group.scheduledTime =
        object["scheduledTime"].as<String>();
      group.status = object["status"].as<String>();

      if (!object["chamberIds"].is<JsonArray>()) {
        Serial.println("Invalid chamber array rejected.");
        return;
      }

      for (
        JsonVariant value :
        object["chamberIds"].as<JsonArray>()
      ) {
        if (!value.is<int>()) {
          Serial.println("Non-integer chamber ID rejected.");
          return;
        }

        group.chamberIds.push_back(value.as<int>());
      }

      if (!validateGroup(group)) {
        Serial.println("Invalid schedule group rejected.");
        return;
      }

      for (int chamberId : group.chamberIds) {
        if (assigned[chamberId - 1]) {
          Serial.println("Duplicate chamber assignment rejected.");
          return;
        }

        assigned[chamberId - 1] = true;
      }

      // Prevent replay when the server already records
      // dispensing or a final outcome.
      group.started =
        group.status == "dispensed" ||
        group.status == "taken" ||
        group.status == "late" ||
        group.status == "missed";

      group.localDone =
        group.status == "taken" ||
        group.status == "late" ||
        group.status == "missed";

      loaded.push_back(group);
    }
  }

  std::sort(
    loaded.begin(),
    loaded.end(),
    [](const AlarmGroup& left, const AlarmGroup& right) {
      return left.hour * 60 + left.minute <
             right.hour * 60 + right.minute;
    }
  );

  xSemaphoreTake(stateMutex, portMAX_DELAY);

  // Never replace an active alarm's group.
  if (!alarmActive && !hardwareFault) {
    if (planDate == currentPlanDate) {
      for (AlarmGroup& group : loaded) {
        for (const AlarmGroup& old : alarms) {
          if (old.groupId == group.groupId) {
            group.started = group.started || old.started;
            group.localDone = group.localDone || old.localDone;
            break;
          }
        }
      }
    }

    alarms.swap(loaded);

    currentPlanId = planId;
    currentPlanDate = planDate;
    systemArmed = enabled;

    Serial.print("Schedule loaded | ");
    Serial.print(currentPlanDate);
    Serial.print(" | Groups ");
    Serial.println(alarms.size());
  }

  xSemaphoreGive(stateMutex);
}

// ======================================================
// NETWORK TASK
// ======================================================

void networkTask(void*) {
  unsigned long lastWiFiAttempt = 0;
  unsigned long lastFetch = 0;

  bool attemptedWiFi = false;
  bool fetched = false;

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);

  while (true) {
    const unsigned long now = millis();

    if (WiFi.status() != WL_CONNECTED) {
      if (
        !attemptedWiFi ||
        now - lastWiFiAttempt >= WIFI_RETRY_INTERVAL_MS
      ) {
        attemptedWiFi = true;
        lastWiFiAttempt = now;

        Serial.println("Starting WiFi connection.");
        WiFi.begin(ssid, password);
      }

      vTaskDelay(pdMS_TO_TICKS(100));
      continue;
    }

    const bool processedEvent = processOneNetworkEvent();

    bool mayFetch = false;

    xSemaphoreTake(stateMutex, portMAX_DELAY);
    mayFetch = !alarmActive;
    xSemaphoreGive(stateMutex);

    if (
      !processedEvent &&
      mayFetch &&
      (
        !fetched ||
        millis() - lastFetch >= SCHEDULE_FETCH_INTERVAL_MS
      )
    ) {
      fetched = true;
      lastFetch = millis();

      fetchSchedule();
    }

    vTaskDelay(pdMS_TO_TICKS(50));
  }
}

// ======================================================
// ALARM
// Called by the main loop while stateMutex is held.
// ======================================================

void resetAlarmState() {
  alarmActive = false;
  buzzerOn = false;
  waitingForHand = false;

  activeAlarmIndex = -1;
  currentPhase = 0;

  buzzerOffSound();
  digitalWrite(LED, LOW);
}

void startBuzzer() {
  buzzerOn = true;
  buzzerStartedAt = millis();

  Serial.print("Alarm phase ");
  Serial.println(currentPhase);
}

void completeAlarm(bool taken) {
  buzzerOn = false;

  buzzerOffSound();
  digitalWrite(LED, LOW);

  if (
    activeAlarmIndex < 0 ||
    activeAlarmIndex >= static_cast<int>(alarms.size())
  ) {
    setHardwareFault("Active group index is invalid.");
    resetAlarmState();
    return;
  }

  AlarmGroup& group = alarms[activeAlarmIndex];

  if (
    !queueEvent(
      taken ? "taken" : "missed",
      group,
      currentPhase,
      0
    )
  ) {
    setHardwareFault("Could not queue final medication event.");
  }

  group.localDone = true;

  // Leave the carousel at its last estimated chamber.
  // Sending write(0) would rotate a continuous servo;
  // it would not return the carousel to HOME.

  resetAlarmState();

  if (hardwareFault) {
    digitalWrite(LED, HIGH);
  }
}

void processActiveAlarm() {
  unsigned long now = millis();

  if (buzzerOn) {
    if (now - buzzerStartedAt >= ALARM_DURATION_MS) {
      buzzerOn = false;

      buzzerOffSound();

      snoozeStartedAt = millis();
      Serial.println("Snooze wait started.");
    } else {
      const unsigned long cycle =
        (now - buzzerStartedAt) % 1000;

      if (cycle < 300) {
        buzzerOnSound();
      } else {
        buzzerOffSound();
      }
    }
  }

  now = millis();

  // Pickup remains active during both the buzzer
  // and silent snooze periods.
  if (
    waitingForHand &&
    now - pickupEnabledAt >= SENSOR_SETTLE_MS &&
    now - lastSensorCheck >= SENSOR_CHECK_INTERVAL_MS
  ) {
    lastSensorCheck = now;

    if (detectHand()) {
      completeAlarm(true);
      return;
    }
  }

  // Refresh after sensor reads and after snoozeStartedAt
  // changes, preserving the reference timing fix.
  now = millis();

  if (
    !buzzerOn &&
    now - snoozeStartedAt >= SNOOZE_WAIT_MS
  ) {
    ++currentPhase;

    if (currentPhase <= MAX_SNOOZES) {
      startBuzzer();
    } else {
      completeAlarm(false);
      return;
    }
  }

  digitalWrite(LED, buzzerOn ? HIGH : LOW);
}

void triggerDueAlarm(const struct tm& localTime) {
  if (
    alarmActive ||
    !systemArmed ||
    hardwareFault ||
    currentPlanDate != dateKey(localTime)
  ) {
    return;
  }

  const int currentMinutes =
    localTime.tm_hour * 60 + localTime.tm_min;

  for (size_t index = 0; index < alarms.size(); ++index) {
    AlarmGroup& group = alarms[index];

    if (group.started || group.localDone) {
      continue;
    }

    const int scheduledMinutes =
      group.hour * 60 + group.minute;

    const int minutesLate =
      currentMinutes - scheduledMinutes;

    if (
      minutesLate < 0 ||
      minutesLate > MAX_LATE_TRIGGER_MINUTES
    ) {
      continue;
    }

    // Reserve room for dispensing and its final outcome.
    if (pendingEvents.size() > MAX_PENDING_EVENTS - 2) {
      Serial.println(
        "Dispensing deferred: backend queue is full."
      );
      return;
    }

    group.started = true;

    alarmActive = true;
    activeAlarmIndex = static_cast<int>(index);
    currentPhase = 0;
    waitingForHand = false;

    Serial.print("DUE GROUP | ");
    Serial.print(group.groupId);
    Serial.print(" | Actual ");
    Serial.print(localTime.tm_hour);
    Serial.print(":");
    Serial.print(localTime.tm_min);
    Serial.print(":");
    Serial.println(localTime.tm_sec);

    time_t dispensedAt = 0;

    if (!dispenseGroup(group, dispensedAt)) {
      // Do not automatically retry a possibly
      // partially completed dispensing sequence.
      setHardwareFault(
        "Dispensing sequence could not complete."
      );

      resetAlarmState();
      digitalWrite(LED, HIGH);
      return;
    }

    if (
      !queueEvent(
        "dispensed",
        group,
        0,
        dispensedAt
      )
    ) {
      setHardwareFault(
        "Could not queue dispensing event."
      );

      resetAlarmState();
      digitalWrite(LED, HIGH);
      return;
    }

    // Start pickup monitoring only after all assigned
    // chambers have completed dispensing and gate closure.
    pickupEnabledAt = millis();
    lastSensorCheck = pickupEnabledAt;
    waitingForHand = true;

    startBuzzer();
    return;
  }
}

// ======================================================
// SETUP
// ======================================================

void setup() {
  Serial.begin(115200);

  pinMode(LED, OUTPUT);
  pinMode(BUZZER, OUTPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  digitalWrite(LED, LOW);
  digitalWrite(BUZZER, LOW);
  digitalWrite(TRIG_PIN, LOW);

  stateMutex = xSemaphoreCreateMutex();

  if (stateMutex == nullptr || !initializeBuzzer()) {
    Serial.println("ERROR: Firmware initialization failed.");

    while (true) {
      digitalWrite(LED, HIGH);
      delay(500);

      digitalWrite(LED, LOW);
      delay(500);
    }
  }

  carouselServo.setPeriodHertz(50);
  carouselServo.attach(CAROUSEL_SERVO, 500, 2500);

  // Issue neutral immediately after attaching.
  if (carouselServo.attached()) {
    carouselServo.writeMicroseconds(CAROUSEL_STOP_US);
  }

  gateServo.setPeriodHertz(50);
  gateServo.attach(GATE_SERVO, 500, 2500);

  if (
    !carouselServo.attached() ||
    !gateServo.attached()
  ) {
    setHardwareFault("Servo PWM attachment failed.");
    return;
  }

  // No automatic homing is possible with the current
  // hardware because it has no position reference sensor.
  currentCarouselChamber = 1;

  if (!stopCarousel() || !closeGate()) {
    setHardwareFault("Initial motor setup failed.");
    return;
  }

  Serial.println(
    "STARTUP ASSUMPTION: Chamber 1 physically aligned with outlet."
  );

  selfTest();

  // NTP synchronizes after the network task connects.
  configTime(
    GMT_OFFSET_SECONDS,
    DAYLIGHT_OFFSET_SECONDS,
    ntpServer
  );

  const BaseType_t created = xTaskCreate(
    networkTask,
    "rxNetwork",
    12288,
    nullptr,
    1,
    &networkTaskHandle
  );

  if (created != pdPASS) {
    setHardwareFault("Network task could not start.");
    return;
  }

  Serial.println("RX BOX READY");
  Serial.println("Carousel: four chambers, timed continuous rotation.");
  Serial.println("Gate servo: GPIO 23.");
  Serial.println("Pickup: ultrasonic TRIG 5 / ECHO 19.");
  Serial.println("Initial alarm = phase 0; first snooze = phase 1.");
}

// ======================================================
// HARDWARE LOOP
// ======================================================

void loop() {
  xSemaphoreTake(stateMutex, portMAX_DELAY);

  if (hardwareFault) {
    buzzerOffSound();
    digitalWrite(LED, HIGH);

    xSemaphoreGive(stateMutex);

    delay(20);
    return;
  }

  if (alarmActive) {
    processActiveAlarm();
  } else {
    buzzerOffSound();
    digitalWrite(LED, LOW);

    struct tm localTime = {};

    if (readClock(localTime)) {
      triggerDueAlarm(localTime);
    }
  }

  xSemaphoreGive(stateMutex);

  delay(10);
}
