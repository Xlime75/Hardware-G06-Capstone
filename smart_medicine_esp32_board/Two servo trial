// ------------------------------------------------------
// BUZZER
// ------------------------------------------------------

void buzzerTimerCallback(void*) {
  portENTER_CRITICAL(&buzzerMux);

  if (buzzerEnabled) {
    buzzerLevel = !buzzerLevel;
    gpio_set_level(
      static_cast<gpio_num_t>(BUZZER),
      buzzerLevel ? 1 : 0
    );
  }

  portEXIT_CRITICAL(&buzzerMux);
}

void buzzerOffSound() {
  portENTER_CRITICAL(&buzzerMux);
  buzzerEnabled = false;
  buzzerLevel = false;
  gpio_set_level(static_cast<gpio_num_t>(BUZZER), 0);
  portEXIT_CRITICAL(&buzzerMux);

  if (buzzerTimer != nullptr) {
    esp_timer_stop(buzzerTimer);
  }
}

void buzzerOnSound() {
  if (buzzerTimer == nullptr) {
    return;
  }

  portENTER_CRITICAL(&buzzerMux);
  const bool alreadyEnabled = buzzerEnabled;
  portEXIT_CRITICAL(&buzzerMux);

  if (alreadyEnabled) {
    return;
  }

  const esp_err_t result = esp_timer_start_periodic(
    buzzerTimer,
    BUZZER_HALF_PERIOD_US
  );

  if (result != ESP_OK) {
    Serial.print("ERROR: Buzzer timer start failed: ");
    Serial.println(static_cast<int>(result));
    return;
  }

  portENTER_CRITICAL(&buzzerMux);
  buzzerLevel = false;
  buzzerEnabled = true;
  portEXIT_CRITICAL(&buzzerMux);
}

bool initializeBuzzer() {
  esp_timer_create_args_t arguments = {};
  arguments.callback = buzzerTimerCallback;
  arguments.dispatch_method = ESP_TIMER_TASK;
  arguments.name = "rxBuzzer";

  return esp_timer_create(&arguments, &buzzerTimer) == ESP_OK;
}

void selfTest() {
