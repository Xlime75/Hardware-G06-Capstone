void setHardwareFault(const char* message) {
  hardwareFault = true;
  systemArmed = false;
  buzzerOffSound();
  digitalWrite(LED, HIGH);

  Serial.print("HARDWARE FAULT: ");
  Serial.println(message);
}

bool stopCarousel() {
  if (!carouselServo.attached()) return false;
  carouselServo.writeMicroseconds(CAROUSEL_STOP_US);
  delay(CAROUSEL_SETTLE_TIME_MS);
  return true;
}

bool rotateCarouselSteps(int direction, int steps) {
  if (!carouselServo.attached() || steps < 0) return false;
  if (steps == 0) return stopCarousel();

  const int pulse = (direction > 0) ? CAROUSEL_CW_US : CAROUSEL_CCW_US;
  const unsigned long rotationTime = CAROUSEL_120_DEG_MS * (unsigned long)steps;

  Serial.print("CAROUSEL ROTATE | Direction: ");
  Serial.print(direction > 0 ? "CW" : "CCW");
  Serial.print(" | 120-degree steps: ");
  Serial.print(steps);
  Serial.print(" | Duration ms: ");
  Serial.println(rotationTime);

  carouselServo.writeMicroseconds(pulse);
  delay(rotationTime);
  return stopCarousel();
}

bool moveCarouselToChamber(int chamberId) {
  if (chamberId < 1 || chamberId > NUMBER_OF_CHAMBERS) return false;
  if (!carouselServo.attached()) return false;

  buzzerOffSound();

  // Choose the shorter direction around the 3-position carousel.
  const int targetIndex = chamberId - 1;
  const int currentIndex = currentCarouselChamber - 1;
  const int clockwiseSteps = (targetIndex - currentIndex + NUMBER_OF_CHAMBERS) % NUMBER_OF_CHAMBERS;
  const int counterClockwiseSteps = (currentIndex - targetIndex + NUMBER_OF_CHAMBERS) % NUMBER_OF_CHAMBERS;

  if (clockwiseSteps <= counterClockwiseSteps) {
    if (!rotateCarouselSteps(1, clockwiseSteps)) return false;
  } else {
    if (!rotateCarouselSteps(-1, counterClockwiseSteps)) return false;
  }

  currentCarouselChamber = chamberId;
  Serial.print("CAROUSEL POSITION ESTIMATE: Chamber ");
  Serial.println(currentCarouselChamber);
  return true;
}

bool openGate() {
  if (!gateServo.attached()) return false;
  gateServo.write(GATE_OPEN_ANGLE);
  delay(GATE_SETTLE_TIME_MS);
  return true;
}

bool closeGate() {
  if (!gateServo.attached()) return false;
  gateServo.write(GATE_CLOSED_ANGLE);
  delay(GATE_SETTLE_TIME_MS);
  return true;
}

bool validateGroup(const AlarmGroup& group) {
  if (
    group.groupId.isEmpty() ||
    group.hour < 0 ||
    group.hour > 23 ||
    group.minute < 0 ||
    group.minute > 59 ||
    group.chamberIds.empty() ||
    group.chamberIds.size() > NUMBER_OF_CHAMBERS
  ) {
    return false;
  }

  bool used[NUMBER_OF_CHAMBERS] = {};
  for (int chamberId : group.chamberIds) {
    if (chamberId < 1 || chamberId > NUMBER_OF_CHAMBERS || used[chamberId - 1]) {
      return false;
    }
    used[chamberId - 1] = true;
  }
  return true;
}

bool dispenseGroup(const AlarmGroup& group, time_t& dispensedAt) {
  dispensedAt = 0;
  if (!validateGroup(group) || !carouselServo.attached() || !gateServo.attached()) {
    return false;
  }

  // Keep the gate closed before moving to any tower.
  if (!closeGate()) return false;

  for (int chamberId : group.chamberIds) {
    if (!moveCarouselToChamber(chamberId)) return false;

    Serial.print("DISPENSING | Tower/Chamber ");
    Serial.println(chamberId);

    if (!openGate()) return false;
    delay(DISPENSE_DELAY_MS);
    if (!closeGate()) return false;
  }

  // Keep the carousel at its last known chamber; do not issue a false HOME angle
  // to a continuous-rotation servo.
  dispensedAt = time(nullptr);
  Serial.println("Dispensing sequence completed; gate closed.");
  return true;
}

